---
import type { MenuCategory } from '../../../schemas/restaurant.schema';
interface Props { categories: MenuCategory[]; }
const { categories } = Astro.props;
---
<nav class="zg-cat-nav">
  {categories.map((cat,i)=>(<button class="zg-cat-btn" data-category={cat.id}><span class="zg-cat-num">{String(i+1).padStart(2,'0')}</span>{cat.name}</button>))}
</nav>
<style>
  .zg-cat-nav { display: flex; flex-direction: column; gap: 0; padding: 2rem 0; }
  .zg-cat-btn { display: flex; align-items: center; gap: 1rem; padding: 1rem 2rem; font-family: var(--zg-font-heading); font-size: 1rem; font-weight: 300; letter-spacing: 0.15em; color: var(--zg-primary); background: none; border: none; border-bottom: 1px solid rgba(0,0,0,0.06); cursor: pointer; text-align: left; transition: all 0.3s; }
  .zg-cat-btn:hover, .zg-cat-btn.active { color: var(--zg-accent); padding-left: 3rem; }
  .zg-cat-num { font-size: 0.625rem; color: rgba(0,0,0,0.3); letter-spacing: 0.1em; }
</style>
<script>
  document.addEventListener('astro:page-load', function() {
    var btns = document.querySelectorAll('.zg-cat-btn');
    var secs = document.querySelectorAll('section[id^="category-"]');
    btns.forEach(function(b) { b.addEventListener('click', function() { var t = document.getElementById('category-' + b.dataset.category); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); });
    var obs = new IntersectionObserver(function(entries) { entries.forEach(function(e) { if (e.isIntersecting) { var id = e.target.id.replace('category-', ''); btns.forEach(function(b) { b.classList.toggle('active', b.dataset.category === id); }); } }); }, { rootMargin: '-20% 0px -60% 0px', threshold: 0.1 });
    secs.forEach(function(s) { obs.observe(s); });
  });
</script>