---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveLogo } from '../../../lib/assets';
import { basePath } from '../../../lib/base';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const logoUrl = resolveLogo(restaurant);
---
<nav class="zg-nav">
  <a href={basePath('/')} class="zg-nav-back">←</a>
  <span class="zg-nav-name">{restaurant.name}</span>
</nav>
<style>
  .zg-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 1.5rem 2rem; }
  .zg-nav-back { font-size: 1rem; color: var(--zg-primary); text-decoration: none; }
  .zg-nav-name { font-family: var(--zg-font-heading); font-size: 0.875rem; letter-spacing: 0.3em; color: var(--zg-primary); }
</style>