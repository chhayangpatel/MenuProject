---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { item, currencySymbol='$', showPrices=true, restaurant } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<div class="zg-item">
  <div class="zg-item-line"></div>
  <div class="zg-item-content">
    <h3 class="zg-item-name">{item.name}</h3>
    {item.description && <p class="zg-item-desc">{item.description}</p>}
    <div class="zg-item-meta">
      <span class="zg-item-price">{currencySymbol}{item.price.toFixed(2)}</span>
      <div class="zg-item-tags">
        {isVeg && !isVegan && <span class="zg-tag">菜</span>}
        {isVegan && <span class="zg-tag">菜</span>}
        {isGF && <span class="zg-tag">GF</span>}
      </div>
    </div>
  </div>
</div>
<style>
  .zg-item { padding: 2rem; position: relative; }
  .zg-item-line { position: absolute; left: 2rem; right: 2rem; bottom: 0; height: 1px; background: rgba(0,0,0,0.06); }
  .zg-item-name { font-family: var(--zg-font-heading); font-size: 1.0625rem; font-weight: 400; letter-spacing: 0.05em; color: var(--zg-primary); margin-bottom: 0.375rem; }
  .zg-item-desc { font-family: var(--zg-font-body); font-size: 0.8125rem; color: rgba(0,0,0,0.4); line-height: 1.7; margin-bottom: 0.75rem; }
  .zg-item-meta { display: flex; justify-content: space-between; align-items: center; }
  .zg-item-price { font-family: var(--zg-font-body); font-size: 0.9375rem; color: var(--zg-accent); }
  .zg-item-tags { display: flex; gap: 0.5rem; }
  .zg-tag { font-size: 0.75rem; color: rgba(0,0,0,0.3); }
</style>