---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
import ItemBadge from '../../../components/ItemBadge.astro';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; showImagePlaceholders?: boolean; }
const { item, currencySymbol='$', showPrices=true, restaurant, showImagePlaceholders=false } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<div class="zg-item" data-item-id={item.id}>
  <div class="zg-item-line"></div>
  {
    hasImage ? (
      <div class="zg-item-img"><img src={imageUrl} alt={item.name} loading="lazy" /></div>
    ) : showImagePlaceholders ? (
      <div class="zg-item-img zg-item-img--ph" aria-hidden="true">
        <span class="zg-item-img-mono">{item.name.charAt(0)}</span>
      </div>
    ) : null
  }
  <div class="zg-item-content">
    <div class="zg-item-title-wrap">
      <h3 class="zg-item-name">{item.name}</h3>
      <ItemBadge item={item} size="sm" />
    </div>
    {item.description && <p class="zg-item-desc">{item.description}</p>}
    <div class="zg-item-meta">
      <div class="zg-item-tags">
        {isVeg && !isVegan && <span class="zg-tag">菜</span>}
        {isVegan && <span class="zg-tag">菜</span>}
        {isGF && <span class="zg-tag">GF</span>}
      </div>
      <span class="zg-item-price">{currencySymbol}{item.price.toFixed(2)}</span>
    </div>
  </div>
</div>
<style>
  .zg-item { padding: 2rem; position: relative; }
  .zg-item-line { position: absolute; left: 2rem; right: 2rem; bottom: 0; height: 1px; background: rgba(0,0,0,0.06); }
  /* Dish photo — renders only when the item has an image; ink-brush rows untouched. */
  .zg-item-img { margin-bottom: 0.9rem; border-radius: 10px; overflow: hidden; aspect-ratio: 16 / 9; background: rgba(0,0,0,0.04); }
  .zg-item-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Monogram placeholder — same block as the photo so mixed rows share one visual rhythm. */
  .zg-item-img--ph { position: relative; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 42%, rgba(0,0,0,0.04), transparent 68%), rgba(0,0,0,0.02); }
  .zg-item-img-mono { font-family: var(--zg-font-heading); font-size: clamp(2rem, 6vw, 3rem); font-weight: 600; line-height: 1; color: color-mix(in srgb, var(--zg-primary) 62%, transparent); transform: translateY(-4%); }
  .zg-item-img--ph::after { content: ""; position: absolute; inset: 8px; border: 1px solid color-mix(in srgb, var(--zg-primary) 8%, transparent); border-radius: 10px; }
  .zg-item-content { display: flex; flex-direction: column; }
  .zg-item-title-wrap { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 0.375rem; }
  .zg-item-name { font-family: var(--zg-font-heading); font-size: 1.0625rem; font-weight: 400; letter-spacing: 0.05em; color: var(--zg-primary); line-height: 1.4; }
  .zg-item-desc { font-family: var(--zg-font-body); font-size: 0.8125rem; color: rgba(0,0,0,0.4); line-height: 1.7; margin-bottom: 0.75rem; }
  .zg-item-meta { display: flex; justify-content: space-between; align-items: center; }
  .zg-item-price { font-family: var(--zg-font-body); font-size: 0.9375rem; color: var(--zg-accent); white-space: nowrap; flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .zg-item-tags { display: flex; gap: 0.5rem; }
  .zg-tag { font-size: 0.75rem; color: rgba(0,0,0,0.3); }
</style>