---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import Footer from '../../../components/Footer.astro';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
---

<div class="zg-footer-wrapper">
  <div class="zg-footer-kanji" aria-hidden="true">一期一会</div>
  <Footer restaurant={restaurant} />
</div>

<style>
  .zg-footer-wrapper {
    position: relative;
    width: 100%;
  }
  .zg-footer-kanji {
    text-align: center;
    font-family: var(--zg-font-heading, serif);
    font-size: 1.25rem;
    letter-spacing: 0.3em;
    color: var(--color-accent, currentColor);
    opacity: 0.5;
    margin-bottom: -2.5rem;
    padding-top: 2rem;
  }
</style>