---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import MenuCard from './MenuCard.astro';
interface Props { items: MenuItem[]; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { items, currencySymbol, showPrices, restaurant } = Astro.props;
---
<section class="zg-featured">
  <h2 class="zg-featured-title">おすすめ</h2>
  <div class="zg-featured-list">
    {items.map(item => (
      <MenuCard item={item} currencySymbol={currencySymbol} showPrices={showPrices} restaurant={restaurant} />
    ))}
  </div>
</section>
<style>
  .zg-featured { padding: 3rem 0; }
  .zg-featured-title { font-family: var(--zg-font-heading); font-size: 0.75rem; letter-spacing: 0.3em; color: var(--zg-accent); padding: 0 2rem; margin-bottom: 1rem; }
  .zg-featured-list { display: flex; flex-direction: column; }
</style>