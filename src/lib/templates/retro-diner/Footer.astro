---
import type { Restaurant } from '../../../schemas/restaurant.schema';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const { hours, contact } = restaurant;
const hourEntries = hours?.regular ? Object.entries(hours.regular) : [];
---
<footer class="rd-footer">
  <p class="rd-footer-name">{restaurant.name}</p>
  {restaurant.tagline && <p class="rd-footer-tagline">{restaurant.tagline}</p>}
  <div class="rd-footer-info">
    {hourEntries.length > 0 && (
      <div class="rd-footer-col">
        <h4>Hours</h4>
        {hourEntries.map(([d,t]) => <p><span>{d}</span> {t}</p>)}
      </div>
    )}
    <div class="rd-footer-col">
      <h4>Visit</h4>
      {contact?.address && <p>{contact.address}</p>}
      {contact?.phone && <p>{contact.phone}</p>}
    </div>
  </div>
  <p class="rd-footer-copy">© {new Date().getFullYear()} {restaurant.name}</p>
</footer>
<style>
  .rd-footer { padding: 3rem 2rem 2rem; background: var(--rd-primary); text-align: center; border-top: 4px solid var(--rd-accent); }
  .rd-footer-name { font-family: var(--rd-font-heading); font-size: 1.5rem; color: #fff; }
  .rd-footer-tagline { color: var(--rd-accent); margin: 0.5rem 0 1.5rem; }
  .rd-footer-info { display: flex; justify-content: center; gap: 4rem; margin-bottom: 2rem; }
  .rd-footer-col h4 { font-family: var(--rd-font-heading); font-size: 0.75rem; color: var(--rd-accent); margin-bottom: 0.5rem; }
  .rd-footer-col p { font-family: var(--rd-font-body); font-size: 0.8125rem; color: rgba(255,255,255,0.6); }
  .rd-footer-col p span { color: #fff; text-transform: uppercase; }
  .rd-footer-copy { font-size: 0.6875rem; color: rgba(255,255,255,0.3); }
</style>