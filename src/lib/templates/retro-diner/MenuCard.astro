---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
import ItemBadge from '../../../components/ItemBadge.astro';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; showImagePlaceholders?: boolean; }
const { item, currencySymbol='$', showPrices=true, restaurant, showImagePlaceholders=false } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<div class="rd-item" data-item-id={item.id} role="button" tabindex="0" aria-label={"View "+item.name}>
  {
    hasImage ? (
      <div class="rd-item-img"><img src={imageUrl} alt={item.name} /></div>
    ) : showImagePlaceholders ? (
      <div class="rd-item-img rd-item-img--ph" aria-hidden="true">
        <span class="rd-item-img-mono">{item.name.charAt(0)}</span>
      </div>
    ) : null
  }
  <div class="rd-item-info">
    <div class="rd-item-title-wrap">
      <h3 class="rd-item-name">{item.name}</h3>
      <ItemBadge item={item} size="sm" />
    </div>
    {item.description && <p class="rd-item-desc">{item.description}</p>}
    <span class="rd-item-price">{currencySymbol}{item.price.toFixed(2)}</span>
  </div>
</div>
<style>
  .rd-item { display: flex; gap: 1rem; padding: 1.25rem; margin: 0.75rem 1rem; background: var(--rd-secondary); border: 3px solid var(--rd-primary); border-radius: 1.5rem; transition: transform 0.3s, box-shadow 0.3s; }
  .rd-item:hover { transform: rotate(-1deg) scale(1.02); box-shadow: 6px 6px 0 0 var(--rd-accent); }
  .rd-item-img { flex-shrink: 0; width: 80px; height: 80px; border-radius: 50%; overflow: hidden; border: 3px solid var(--rd-accent); }
  .rd-item-img img { width: 100%; height: 100%; object-fit: cover; }
  /* Monogram placeholder — same block as the photo so mixed rows share one visual rhythm. */
  .rd-item-img--ph { position: relative; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--rd-accent) 14%, transparent), transparent 68%), color-mix(in srgb, var(--rd-primary) 4%, transparent); }
  .rd-item-img-mono { font-family: var(--rd-font-heading); font-size: 1.75rem; font-weight: 600; line-height: 1; color: color-mix(in srgb, var(--rd-primary) 62%, transparent); }
  .rd-item-img--ph::after { content: ""; position: absolute; inset: 8px; border: 1px dashed color-mix(in srgb, var(--rd-accent) 40%, transparent); border-radius: 50%; }
  .rd-item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .rd-item-title-wrap { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 0.25rem; }
  .rd-item-name { font-family: var(--rd-font-heading); font-size: 1.125rem; color: var(--rd-primary); line-height: 1.3; }
  .rd-item-desc { font-family: var(--rd-font-body); font-size: 0.8125rem; color: rgba(0,0,0,0.5); line-height: 1.5; margin-bottom: 0.5rem; }
  .rd-item-price { font-family: var(--rd-font-heading); font-size: 1.125rem; color: var(--rd-accent); align-self: flex-end; margin-top: auto; white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>