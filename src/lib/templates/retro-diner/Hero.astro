---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveCover, resolveLogo } from '../../../lib/assets';
import HeroStory from '../../../components/HeroStory.astro';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const heroStyle = restaurant.hero?.style || 'fullbleed';
const hasCover = !!restaurant.coverImage;
const coverUrl = resolveCover(restaurant);
const logoUrl = resolveLogo(restaurant);
---

<div class="rd-hero" style={hasCover && heroStyle !== 'minimal' ? 'min-height: 70vh;' : 'padding: 5rem 1.5rem 3rem;'}>
  {hasCover && heroStyle !== 'minimal' && (
    <>
      <img src={coverUrl} alt="" class="rd-hero-bg" loading="eager" />
      <div class="rd-hero-scrim"></div>
    </>
  )}
  <div class="rd-hero-content relative z-10 w-full text-center px-6">
    <div class="rd-logo-ring mb-6 mx-auto">
      <img src={logoUrl} alt={restaurant.name} class="rd-logo-img" />
    </div>
    <h1 class={"rd-hero-title " + (hasCover && heroStyle !== 'minimal' ? 'rd-text-light' : 'rd-text-dark')}>
      {restaurant.name}
    </h1>
    <div class="rd-divider" aria-hidden="true"></div>
    {restaurant.tagline && (
      <p class={"rd-hero-tagline " + (hasCover && heroStyle !== 'minimal' ? 'rd-text-light' : 'rd-text-dark')}>
        {restaurant.tagline}
      </p>
    )}
    <HeroStory restaurant={restaurant} light={hasCover && heroStyle !== 'minimal'} />
    {hasCover && heroStyle === 'fullbleed' && (
      <div class="rd-scroll-cue mt-8">
        <span class="rd-scroll-dot"></span>
        <span class="rd-scroll-text">Scroll to explore</span>
      </div>
    )}
  </div>
</div>

<style>
  .rd-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    background: var(--rd-primary);
  }

  .rd-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rd-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  .rd-hero-content {
    padding-bottom: 3rem;
    padding-top: 5rem;
    animation: rd-contentUp 0.8s ease-out both;
  }

  @keyframes rd-contentUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .rd-logo-ring {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    padding: 4px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 3px var(--rd-accent), 0 0 20px var(--rd-accent);
    animation: rd-logoPop 0.7s ease-out 0.2s both;
  }

  @keyframes rd-logoPop {
    from { opacity: 0; transform: scale(0.7); }
    to   { opacity: 1; transform: scale(1); }
  }

  .rd-logo-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--rd-secondary);
  }

  .rd-hero-title {
    font-family: var(--rd-font-heading);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
    text-shadow: 0 0 20px var(--rd-accent), 0 0 40px var(--rd-accent);
  }

  .rd-text-light { color: #fff; }
  .rd-text-dark  { color: #fff; }

  .rd-divider {
    width: 60px;
    height: 3px;
    background: var(--rd-accent);
    margin: 1rem auto 1.25rem;
    animation: rd-dividerGrow 0.6s ease-out 0.5s both;
    box-shadow: 0 0 10px var(--rd-accent);
  }

  @keyframes rd-dividerGrow {
    from { width: 0; opacity: 0; }
    to   { width: 60px; opacity: 1; }
  }

  .rd-hero-tagline {
    font-family: var(--rd-font-body);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    max-width: 36ch;
    margin: 0 auto;
    animation: rd-contentUp 0.8s ease-out 0.1s both;
  }

  .rd-scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0.7;
    animation: rd-contentUp 0.8s ease-out 0.8s both;
  }

  .rd-scroll-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rd-accent);
    animation: rd-scrollBounce 2s ease-in-out infinite;
    box-shadow: 0 0 10px var(--rd-accent);
  }

  .rd-scroll-text {
    font-family: var(--rd-font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--rd-accent);
  }

  @keyframes rd-scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%       { transform: translateY(10px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rd-hero-content, .rd-logo-ring, .rd-hero-tagline, .rd-divider, .rd-scroll-cue {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>