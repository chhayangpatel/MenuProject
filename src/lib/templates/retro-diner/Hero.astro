---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveCover, resolveLogo } from '../../../lib/assets';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const hasCover = !!restaurant.coverImage;
const coverUrl = resolveCover(restaurant);
const logoUrl = resolveLogo(restaurant);
---
<div class="rd-hero">
  {hasCover && <img src={coverUrl} alt="" class="rd-hero-bg" />}
  <div class="rd-hero-content">
    <img src={logoUrl} alt={restaurant.name} class="rd-hero-logo" />
    <h1 class="rd-hero-title">{restaurant.name}</h1>
    {restaurant.tagline && <p class="rd-hero-tagline">{restaurant.tagline}</p>}
  </div>
</div>
<style>
  .rd-hero { position: relative; min-height: 70vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--rd-primary); }
  .rd-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.3; }
  .rd-hero-content { position: relative; z-index: 1; text-align: center; padding: 2rem; }
  .rd-hero-logo { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 4px solid var(--rd-accent); margin-bottom: 1.5rem; animation: rd-bounce 2s ease-in-out infinite; }
  .rd-hero-title { font-family: var(--rd-font-heading); font-size: clamp(2.5rem, 7vw, 4.5rem); color: #fff; text-shadow: 0 0 20px var(--rd-accent), 0 0 40px var(--rd-accent); margin-bottom: 0.75rem; }
  .rd-hero-tagline { font-family: var(--rd-font-body); font-size: 1.125rem; color: var(--rd-accent); letter-spacing: 0.1em; }
  @keyframes rd-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
</style>