---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import MenuCard from './MenuCard.astro';
interface Props { items: MenuItem[]; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { items, currencySymbol, showPrices, restaurant } = Astro.props;
const featured = items.slice(0, 4);
---
<section class="rd-featured">
  <div class="rd-featured-header">
    <h2 class="rd-featured-title">★ Must-Try Specials ★</h2>
    <p class="rd-featured-subline">The crowd favourites — order these before they're gone!</p>
  </div>
  <div class="rd-featured-grid" role="list" aria-label="Featured items">
    {featured.map(item => (
      <div class="rd-featured-card" role="listitem">
        <MenuCard item={item} currencySymbol={currencySymbol} showPrices={showPrices} restaurant={restaurant} />
      </div>
    ))}
  </div>
</section>
<style>
  .rd-featured { padding: 3rem 0; }
  .rd-featured-header { text-align: center; margin-bottom: 2rem; padding: 0 1rem; }
  .rd-featured-title { font-family: var(--rd-font-heading); font-size: 1.5rem; color: var(--rd-accent); margin: 0 0 0.5rem; }
  .rd-featured-subline { font-family: var(--rd-font-body); font-size: 0.875rem; color: rgba(0,0,0,0.5); margin: 0; }
  .rd-featured-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; padding: 0 1rem; align-items: stretch; }
  .rd-featured-card { display: flex; flex-direction: column; height: 100%; }
  @media (min-width: 540px) { .rd-featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .rd-featured-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>