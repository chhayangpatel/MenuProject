---
import type { MenuCategory } from '../../../schemas/restaurant.schema';
import { resolveCategoryHeroImage } from '../../../lib/assets';
interface Props { category: MenuCategory; slug: string; categoryIndex: number; restaurant: any; }
const { category, categoryIndex, restaurant } = Astro.props;
const imageUrl = resolveCategoryHeroImage(restaurant, category.heroImage);
---
<div class="ac-cat-header">
  <h2 class="ac-cat-title">{category.name}</h2>
  {category.description && <p class="ac-cat-desc">{category.description}</p>}
</div>
<style>
  .ac-cat-header { padding: 3rem 2rem 1.5rem; text-align: center; }
  .ac-cat-title { font-family: var(--ac-font-heading); font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 600; color: var(--ac-primary); margin-bottom: 0.5rem; }
  .ac-cat-desc { font-family: var(--ac-font-body); font-size: 0.9375rem; color: rgba(0,0,0,0.5); max-width: 40ch; margin: 0 auto; }
</style>