---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import MenuCard from './MenuCard.astro';
interface Props { items: MenuItem[]; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { items, currencySymbol, showPrices, restaurant } = Astro.props;
const featured = items.slice(0, 4);
---
<section class="ac-featured">
  <div class="ac-featured-header">
    <h2 class="ac-featured-title">House Favorites</h2>
    <p class="ac-featured-subline">Handpicked by our team — the dishes that define us</p>
  </div>
  <div class="ac-featured-grid" role="list" aria-label="Featured items">
    {featured.map(item => (
      <div class="ac-featured-card" role="listitem">
        <MenuCard item={item} currencySymbol={currencySymbol} showPrices={showPrices} restaurant={restaurant} />
      </div>
    ))}
  </div>
</section>
<style>
  .ac-featured { padding: 3rem 0; }
  .ac-featured-header { text-align: center; margin-bottom: 2rem; padding: 0 1.5rem; }
  .ac-featured-title { font-family: var(--ac-font-heading); font-size: 1.5rem; font-weight: 600; color: var(--ac-primary); margin: 0 0 0.5rem; }
  .ac-featured-subline { font-family: var(--ac-font-body); font-size: 0.875rem; color: rgba(0,0,0,0.5); margin: 0; }
  .ac-featured-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; padding: 0 1.5rem; align-items: stretch; }
  .ac-featured-card { display: flex; flex-direction: column; height: 100%; }
  @media (min-width: 540px) { .ac-featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .ac-featured-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>