---
import type { MenuCategory } from '../../../schemas/restaurant.schema';
interface Props { categories: MenuCategory[]; }
const { categories } = Astro.props;
---
<nav class="ac-cat-nav">
  {categories.map((cat,i)=>(<button class="ac-cat-btn" data-category={cat.id}>{cat.name}</button>))}
</nav>
<style>
  .ac-cat-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 2rem; justify-content: center; }
  .ac-cat-btn { padding: 0.625rem 1.25rem; border-radius: 2px; border: 1px solid var(--ac-primary); background: transparent; font-family: var(--ac-font-body); font-size: 0.8125rem; color: var(--ac-primary); cursor: pointer; transition: all 0.3s; }
  .ac-cat-btn:hover, .ac-cat-btn.active { background: var(--ac-primary); color: var(--ac-secondary); }
</style>
<script>
  document.addEventListener('astro:page-load', function() {
    var btns = document.querySelectorAll('.ac-cat-btn');
    var secs = document.querySelectorAll('section[id^="category-"]');
    btns.forEach(function(b) { b.addEventListener('click', function() { var t = document.getElementById('category-' + b.dataset.category); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); });
    var obs = new IntersectionObserver(function(entries) { entries.forEach(function(e) { if (e.isIntersecting) { var id = e.target.id.replace('category-', ''); btns.forEach(function(b) { b.classList.toggle('active', b.dataset.category === id); }); } }); }, { rootMargin: '-20% 0px -60% 0px', threshold: 0.1 });
    secs.forEach(function(s) { obs.observe(s); });
  });
</script>