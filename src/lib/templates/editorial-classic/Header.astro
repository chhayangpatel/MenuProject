---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveLogo } from '../../../lib/assets';
import { basePath } from '../../../lib/base';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const { contact } = restaurant;
const logoUrl = resolveLogo(restaurant);
---

<header class="ec-nav-pill" id="ec-main-header">
  <div class="ec-nav-progress" id="ec-nav-progress"></div>
  <div class="ec-nav-pill-inner" id="ec-nav-pill-inner">
    <a href={basePath('/')} class="ec-back-link" aria-label="Back to all restaurants">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
      </svg>
    </a>
    <img src={logoUrl} alt={restaurant.name} class="ec-nav-logo" />
    <span class="ec-nav-name">{restaurant.name}</span>
    <div class="ec-nav-divider" aria-hidden="true"></div>
    <nav class="ec-nav-actions" aria-label="Contact">
      {contact?.phone && (
        <a href={"tel:" + contact.phone} aria-label="Call us" class="ec-nav-action" title="Call us">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.4 19.79 19.79 0 0 1 1.61 4.78 2 2 0 0 1 3.58 2.6h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l1.06-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17.5z"/>
          </svg>
        </a>
      )}
      {contact?.whatsapp && (
        <a href={"https://wa.me/" + contact.whatsapp.replace(/[^0-9]/g, '')} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="ec-nav-action" title="WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.885 3.488"/>
          </svg>
        </a>
      )}
      {contact?.googleMapsUrl && (
        <a href={contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Get Directions" class="ec-nav-action" title="Directions">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </a>
      )}
    </nav>
  </div>
</header>

<style>
  .ec-back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: color-mix(in srgb, var(--ec-primary) 55%, transparent);
    transition: color 0.2s, background 0.2s, transform 0.25s var(--ec-ease-spring);
    flex-shrink: 0;
  }
  .ec-back-link:hover {
    color: var(--ec-gold);
    background: color-mix(in srgb, var(--ec-gold) 10%, transparent);
    transform: translateX(-4px);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const pill = document.getElementById('ec-nav-pill-inner');
    const progressBar = document.getElementById('ec-nav-progress');
    if (!pill) return;

    let lastScroll = 0;

    window.addEventListener('scroll', () => {
      const current = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = maxScroll > 0 ? (current / maxScroll) * 100 : 0;

      if (progressBar) {
        progressBar.style.width = scrollPercent + '%';
      }

      if (current > 120 && current > lastScroll) {
        pill.classList.add('compact');
      } else {
        pill.classList.remove('compact');
      }
      lastScroll = current;
    }, { passive: true });
  });
</script>