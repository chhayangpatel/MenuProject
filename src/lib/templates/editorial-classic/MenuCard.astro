---
import type { MenuItem } from "../../../schemas/restaurant.schema";
import { resolveMenuItemImage } from "../../../lib/assets";
import ItemBadge from "../../../components/ItemBadge.astro";

interface Props {
  item: MenuItem;
  currencySymbol?: string;
  showPrices?: boolean;
  restaurant: any;
  showImagePlaceholders?: boolean;
}

const {
  item,
  currencySymbol = "$",
  showPrices = true,
  restaurant,
  showImagePlaceholders = false,
} = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : "";
const isVegetarian = item.tags.includes("vegetarian");
const isVegan = item.tags.includes("vegan");
const isGlutenFree = item.tags.includes("gluten-free");
const hasVariants = item.variants && item.variants.length > 0;
---

<!--
  Editorial Classic item — formatted like a printed fine-dining menu:
  name ········ price, description below in relaxed serif.
  No box, no borders — the page is the menu paper.
-->
<article
  class:list={[
    "ec-row",
    !item.available && "ec-row--unavailable",
    item.featured && "ec-row--featured",
  ]}
  data-item-id={item.id}
  role="button"
  tabindex="0"
  aria-label={"View details for " + item.name}
>
  {
    hasImage ? (
      <div class="ec-item-img">
        <img src={imageUrl} alt={item.name} loading="lazy" />
      </div>
    ) : showImagePlaceholders ? (
      <div class="ec-item-img ec-item-img--ph" aria-hidden="true">
        <span class="ec-item-img-mono">{item.name.charAt(0)}</span>
      </div>
    ) : null
  }
  <div class="ec-row__top">
    <div class="ec-row-name-wrap">
      <h3 class="ec-row-name">{item.name}</h3>
      <ItemBadge item={item} size="sm" />
    </div>
    <span class="ec-row__leader" aria-hidden="true"></span>
    {
      showPrices && (
        <span
          class="ec-row-price"
          aria-label={currencySymbol + item.price.toFixed(2)}
        >
          {hasVariants && <span class="ec-row-price-from">from </span>}
          {currencySymbol}
          {item.price.toFixed(2)}
        </span>
      )
    }
  </div>

  {item.description && <p class="ec-row-desc">{item.description}</p>}

  {/* Dietary + meta markers */}
  <div class="ec-row-meta">
    {
      !item.available && (
        <span class="ec-row-tag ec-row-tag--sold">Sold Out</span>
      )
    }

    {
      isVegetarian && !isVegan && (
        <span class="ec-row-tag ec-row-tag--green">Vegetarian</span>
      )
    }
    {isVegan && <span class="ec-row-tag ec-row-tag--green">Vegan</span>}
    {
      isGlutenFree && (
        <span class="ec-row-tag ec-row-tag--amber">Gluten-Free</span>
      )
    }
    {
      item.spicyLevel > 0 && (
        <span class="ec-row-tag ec-row-tag--red">
          {"🌶️".repeat(item.spicyLevel)}
        </span>
      )
    }
    {
      item.portionSize && (
        <span class="ec-row-tag ec-row-tag--muted">{item.portionSize}</span>
      )
    }
    {
      item.prepTime && (
        <span class="ec-row-tag ec-row-tag--muted">⏱ {item.prepTime}min</span>
      )
    }
    {hasImage && <span class="ec-row-tag ec-row-tag--muted">photo</span>}
  </div>
</article>

<style>
  /* ── Dotted leader row (the fine-dining signature) ────────────────── */
  .ec-row {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 0.25rem;
    cursor: pointer;
    border-bottom: 1px solid
      color-mix(in srgb, var(--ec-primary) 7%, transparent);
    transition: background 0.25s var(--ec-ease-out-expo);
    flex: 1;
  }

  /* Dish photo — renders only when the item has an image; text-only rows
     (the editorial signature) are untouched. */
  .ec-item-img {
    margin: 0 0 0.9rem;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: color-mix(in srgb, var(--ec-primary) 5%, transparent);
  }
  .ec-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Monogram placeholder — same block as the photo so mixed rows share one
     visual rhythm (photo rows and text rows align in the items grid). */
  .ec-item-img--ph {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(
        circle at 50% 42%,
        color-mix(in srgb, var(--ec-gold) 9%, transparent),
        transparent 68%
      ),
      color-mix(in srgb, var(--ec-primary) 3.5%, transparent);
  }
  .ec-item-img-mono {
    font-family: var(--ec-font-heading);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 600;
    line-height: 1;
    color: color-mix(in srgb, var(--ec-gold) 62%, transparent);
    transform: translateY(-4%);
  }
  /* Hairline frame keeps the quiet tile intentional, not empty */
  .ec-item-img--ph::after {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid
      color-mix(in srgb, var(--ec-primary) 8%, transparent);
    border-radius: 10px;
  }
  .ec-row:hover {
    background: color-mix(in srgb, var(--ec-gold) 5%, transparent);
  }

  .ec-row__top {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .ec-row-name-wrap {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    flex-shrink: 1;
    min-width: 0;
  }

  .ec-row-name {
    font-family: var(--ec-font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--ec-primary);
    transition: color 0.25s ease;
    margin: 0;
  }
  .ec-row:hover .ec-row-name {
    color: var(--ec-gold);
  }

  /* Dotted leader only on wide-enough screens; phones just space */
  .ec-row__leader {
    flex: 1 1 auto;
    min-width: 1.5rem;
    border-bottom: 1px dotted
      color-mix(in srgb, var(--ec-primary) 25%, transparent);
    transform: translateY(-4px);
  }
  @media (max-width: 479px) {
    .ec-row__leader {
      display: none;
    }
  }

  .ec-row-price {
    font-family: var(--ec-font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ec-accent);
    white-space: nowrap;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    /* Keeps the price flush-right when the dotted leader is hidden on phones */
    margin-left: auto;
  }
  .ec-row-price-from {
    font-size: 0.75em;
    font-weight: 400;
    color: color-mix(in srgb, var(--ec-accent) 75%, transparent);
  }

  .ec-row-desc {
    font-family: var(--ec-font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--ec-primary) 58%, transparent);
    max-width: 60ch;
    margin-bottom: 0.5rem;
    flex: 1;
  }

  .ec-row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }
  .ec-row-tag {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .ec-row-tag--gold {
    background: color-mix(in srgb, var(--ec-gold) 18%, transparent);
    color: color-mix(in srgb, var(--ec-gold) 85%, #7a5c10);
  }
  .ec-row-tag--green {
    background: #dcfce7;
    color: #15803d;
  }
  .ec-row-tag--amber {
    background: #fef3c7;
    color: #b45309;
  }
  .ec-row-tag--red {
    background: #fee2e2;
    color: #b91c1c;
  }
  .ec-row-tag--muted {
    background: color-mix(in srgb, var(--ec-primary) 6%, transparent);
    color: color-mix(in srgb, var(--ec-primary) 50%, transparent);
  }
  .ec-row-tag--sold {
    background: color-mix(in srgb, var(--ec-primary) 12%, transparent);
    color: var(--ec-primary);
    text-decoration: line-through;
  }

  .ec-row--unavailable {
    opacity: 0.5;
    filter: grayscale(0.3);
    pointer-events: none;
  }
  .ec-row--featured .ec-row-name {
    color: color-mix(in srgb, var(--ec-gold) 40%, var(--ec-primary));
  }

  @media (min-width: 760px) {
    .ec-row {
      padding: 1.25rem 0.5rem;
    }
    .ec-row-name {
      font-size: 1.125rem;
    }
    .ec-row-desc {
      font-size: 0.9375rem;
    }
  }

  /* Reduced motion: keep rows calm */
  @media (prefers-reduced-motion: reduce) {
    .ec-row {
      transition: none;
    }
    .ec-row:hover {
      background: transparent;
    }
  }
</style>