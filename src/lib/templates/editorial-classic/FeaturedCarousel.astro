---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import MenuCard from './MenuCard.astro';

interface Props {
  items: MenuItem[];
  currencySymbol?: string;
  showPrices?: boolean;
  restaurant: any;
}

const { items, currencySymbol, showPrices, restaurant } = Astro.props;
---

<section class="ec-featured-carousel" aria-labelledby="ec-featured-heading">
  <div class="ec-featured-header">
    <div class="ec-featured-label" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
      Must-Try Dishes
    </div>
    <h2 class="ec-featured-heading" id="ec-featured-heading">Chef's Selection</h2>
  </div>

  <div class="ec-featured-track" role="list" aria-label="Featured items carousel">
    {items.map(item => (
      <div class="ec-featured-card" role="listitem">
        <MenuCard
          item={item}
          currencySymbol={currencySymbol}
          showPrices={showPrices}
          restaurant={restaurant}
        />
      </div>
    ))}
  </div>
</section>

<style>
  /* Styles in editorial-classic/styles.css */
</style>