---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { item, currencySymbol='$', showPrices=true, restaurant } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<article class="bs-card-outer" data-item-id={item.id} role="button" tabindex="0" aria-label={"View "+item.name}>
  <div class="bs-card">
    <div class="bs-card-body">
      <div class="bs-card-text">
        <div style="display:flex;justify-content:space-between;gap:1rem;margin-bottom:0.5rem;">
          <h3 class="bs-item-name">{item.name}</h3>
          {showPrices && <span class="bs-item-price">{hasVariants?'From ':''}{currencySymbol}{item.price.toFixed(2)}</span>}
        </div>
        {item.description && <p class="bs-item-desc">{item.description}</p>}
        <div style="display:flex;flex-wrap:wrap;gap:0.375rem;margin-top:0.5rem;">
          {isVeg && !isVegan && <span style="background:#FF1744;color:#fff;padding:2px 8px;border-radius:0;font-size:0.625rem;font-weight:700;">VEG</span>}
          {isVegan && <span style="background:#00FF87;color:#0A0A0A;padding:2px 8px;border-radius:0;font-size:0.625rem;font-weight:700;">VEGAN</span>}
          {isGF && <span style="background:#00E5FF;color:#0A0A0A;padding:2px 8px;border-radius:0;font-size:0.625rem;font-weight:700;">GF</span>}
          {item.spicyLevel>0 && <span style="background:#FF1744;color:#fff;padding:2px 8px;border-radius:0;font-size:0.625rem;font-weight:700;">{"🔥".repeat(item.spicyLevel)}</span>}
        </div>
      </div>
      {hasImage && <div class="bs-card-img-wrap"><img src={resolveMenuItemImage(restaurant, item.image)} alt={item.name} class="bs-card-img" loading="lazy" /></div>}
    </div>
  </div>
</article>