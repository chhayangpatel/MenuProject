---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
import ItemBadge from '../../../components/ItemBadge.astro';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { item, currencySymbol='$', showPrices=true, restaurant } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<article class="bs-card-outer" data-item-id={item.id} role="button" tabindex="0" aria-label={"View "+item.name}>
  <div class="bs-card">
    <div class="bs-card-body">
      <div class="bs-card-text">
        <div class="bs-card-header">
          <div class="bs-card-title-wrap">
            <h3 class="bs-item-name">{item.name}</h3>
            <ItemBadge item={item} size="sm" />
          </div>
          {showPrices && <span class="bs-item-price">{hasVariants?'From ':''}{currencySymbol}{item.price.toFixed(2)}</span>}
        </div>
        {item.description && <p class="bs-item-desc">{item.description}</p>}
        <div class="bs-card-tags">
          {isVeg && !isVegan && <span class="bs-tag bs-tag--veg">VEG</span>}
          {isVegan && <span class="bs-tag bs-tag--vegan">VEGAN</span>}
          {isGF && <span class="bs-tag bs-tag--gf">GF</span>}
          {item.spicyLevel>0 && <span class="bs-tag bs-tag--spicy">{"🔥".repeat(item.spicyLevel)}</span>}
        </div>
      </div>
      {hasImage && <div class="bs-card-img-wrap"><img src={resolveMenuItemImage(restaurant, item.image)} alt={item.name} class="bs-card-img" loading="lazy" /></div>}
    </div>
  </div>
</article>

<style>
  .bs-card-outer {
    padding: 0.75rem 0;
  }
  .bs-card {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 0;
    padding: 1rem 0;
    transition: all 0.2s ease;
  }
  .bs-card:hover {
    border-color: var(--bs-accent);
    background: rgba(255,23,68,0.02);
  }
  .bs-card-body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .bs-card-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .bs-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .bs-card-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 1;
    min-width: 0;
  }
  .bs-item-name {
    font-family: var(--bs-font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--bs-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .bs-item-price {
    font-family: var(--bs-font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--bs-accent);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .bs-item-desc {
    font-family: var(--bs-font-body);
    font-size: 0.8125rem;
    color: rgba(0,0,0,0.55);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }
  .bs-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }
  .bs-tag {
    padding: 2px 8px;
    border-radius: 0;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .bs-tag--veg {
    background: #FF1744;
    color: #fff;
  }
  .bs-tag--vegan {
    background: #00FF87;
    color: #0A0A0A;
  }
  .bs-tag--gf {
    background: #00E5FF;
    color: #0A0A0A;
  }
  .bs-tag--spicy {
    background: #FF1744;
    color: #fff;
  }
  .bs-card-img-wrap {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 0;
    overflow: hidden;
  }
  .bs-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>