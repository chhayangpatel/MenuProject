---
import type { Restaurant } from '../../../schemas/restaurant.schema';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const { hours, contact } = restaurant;
const hourEntries = hours?.regular ? Object.entries(hours.regular) : (hours && !hours.regular ? Object.entries(hours as Record<string,string>) : []);
---
<footer class="bs-footer">
  <div class="bs-divider"></div>
  <p style="font-family:var(--bs-font-heading);font-weight:900;font-size:1.5rem;letter-spacing:-0.02em;">{restaurant.name}</p>
  <p style="color:rgba(255,255,255,0.5);font-family:var(--bs-font-body);margin-top:0.5rem;">{restaurant.tagline || 'Late night done right'}</p>
  <div class="bs-divider"></div>
  <div style="display:flex;flex-direction:column;gap:2rem;text-align:center;">
    {hourEntries.length>0 && <div><h4 style="font-size:0.625rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--bs-accent-2);margin-bottom:0.5rem;">HOURS</h4><ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.375rem;">{hourEntries.map(([d,t])=>(<li style="display:flex;justify-content:space-between;gap:1rem;color:rgba(255,255,255,0.7);font-size:0.8125rem;"><span style="font-weight:700;color:#fff;text-transform:uppercase;">{d}</span><span>{t}</span></li>))}</ul></div>}
    <div><h4 style="font-size:0.625rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--bs-accent-2);margin-bottom:0.5rem;">LOCATION</h4>{contact?.address && <p style="color:rgba(255,255,255,0.7);line-height:1.6;margin-bottom:0.5rem;">{contact.address}</p>}{contact?.googleMapsUrl && <a href={contact.googleMapsUrl} target="_blank" rel="noopener" style="color:var(--bs-accent-2);font-weight:700;font-size:0.8125rem;">GET DIRECTIONS</a>}{contact?.phone && <a href={"tel:"+contact.phone} style="display:block;color:rgba(255,255,255,0.7);margin-top:0.25rem;">{contact.phone}</a>}</div>
  </div>
  <div class="bs-divider" style="margin-top:2rem;"></div>
  <p style="font-size:0.75rem;color:rgba(255,255,255,0.3);">© {new Date().getFullYear()} {restaurant.name}</p>
</footer>