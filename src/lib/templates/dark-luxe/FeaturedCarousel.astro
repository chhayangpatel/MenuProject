---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import MenuCard from './MenuCard.astro';
interface Props { items: MenuItem[]; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { items, currencySymbol, showPrices, restaurant } = Astro.props;
const featured = items.slice(0, 4);
---
<section class="dl-featured">
  <h2 class="dl-featured-title">Chef's Selection</h2>
  <div class="dl-featured-grid">
    {featured.map(item => (
      <div class="dl-featured-card">
        <MenuCard item={item} currencySymbol={currencySymbol} showPrices={showPrices} restaurant={restaurant} />
      </div>
    ))}
  </div>
</section>
<style>
  .dl-featured { padding: 4rem 0; }
  .dl-featured-title { font-family: var(--dl-font-heading); font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--dl-gold); text-align: center; margin-bottom: 2rem; }
  .dl-featured-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; padding: 0 2rem; }
  @media (min-width: 540px) { .dl-featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .dl-featured-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
