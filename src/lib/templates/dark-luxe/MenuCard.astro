---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
import ItemBadge from '../../../components/ItemBadge.astro';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; showImagePlaceholders?: boolean; }
const { item, currencySymbol='$', showPrices=true, restaurant, showImagePlaceholders=false } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<div class="dl-item" data-item-id={item.id}>
  {hasImage ? <div class="dl-item-img"><img src={imageUrl} alt={item.name} loading="lazy" /></div> : showImagePlaceholders ? <div class="dl-item-img dl-item-img--ph" aria-hidden="true"><span class="dl-item-img-mono">{item.name.charAt(0)}</span></div> : null}
  <div class="dl-item-content">
    <div class="dl-item-top">
      <div class="dl-item-title-wrap">
        <h3 class="dl-item-name">{item.name}</h3>
        <ItemBadge item={item} size="sm" />
      </div>
      <span class="dl-item-price">{currencySymbol}{item.price.toFixed(2)}</span>
    </div>
    {item.description && <p class="dl-item-desc">{item.description}</p>}
    <div class="dl-item-tags">
      {isVeg && !isVegan && <span class="dl-tag">Vegetarian</span>}
      {isVegan && <span class="dl-tag">Vegan</span>}
      {isGF && <span class="dl-tag">GF</span>}
      {item.spicyLevel>0 && <span class="dl-tag">{"🌶️".repeat(item.spicyLevel)}</span>}
    </div>
  </div>
</div>
<style>
  .dl-item { display: flex; gap: 1.5rem; padding: 1.5rem 2rem; border-bottom: 1px solid rgba(255,255,255,0.06); transition: background 0.3s; }
  .dl-item:hover { background: rgba(255,255,255,0.02); }
  .dl-item-img { flex-shrink: 0; width: 80px; height: 80px; border-radius: 50%; overflow: hidden; }
  .dl-item-img img { width: 100%; height: 100%; object-fit: cover; }
  .dl-item-img--ph { position: relative; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 42%, rgba(212,175,55,0.12), transparent 68%), rgba(255,255,255,0.03); }
  .dl-item-img-mono { font-family: var(--dl-font-heading); font-size: 1.5rem; font-weight: 600; line-height: 1; color: rgba(212,175,55,0.7); }
  .dl-item-img--ph::after { content: ""; position: absolute; inset: 8px; border: 1px dashed rgba(212,175,55,0.3); border-radius: 50%; }
  .dl-item-content { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .dl-item-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.375rem; }
  .dl-item-title-wrap { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex-shrink: 1; min-width: 0; }
  .dl-item-name { font-family: var(--dl-font-heading); font-size: 1.125rem; font-weight: 400; color: #fff; letter-spacing: 0.02em; line-height: 1.4; }
  .dl-item-price { font-family: var(--dl-font-body); font-size: 1rem; color: var(--dl-gold); white-space: nowrap; flex-shrink: 0; }
  .dl-item-desc { font-family: var(--dl-font-body); font-size: 0.8125rem; color: rgba(255,255,255,0.4); line-height: 1.6; margin-bottom: 0.5rem; }
  .dl-item-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
  .dl-tag { font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); border: 1px solid rgba(255,255,255,0.1); padding: 2px 8px; border-radius: 999px; }
</style>