---
import type { MenuCategory } from '../../../schemas/restaurant.schema';
interface Props { categories: MenuCategory[]; }
const { categories } = Astro.props;
---
<nav class="dl-cat-nav">
  <div class="dl-cat-track">
    {categories.map((cat,i)=>(<button class="dl-cat-btn" data-category={cat.id}>{String(i+1).padStart(2,'0')} — {cat.name}</button>))}
  </div>
</nav>
<style>
  .dl-cat-nav { padding: 2rem 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .dl-cat-track { display: flex; gap: 2rem; overflow-x: auto; padding: 0 2rem; scrollbar-width: none; }
  .dl-cat-track::-webkit-scrollbar { display: none; }
  .dl-cat-btn { flex-shrink: 0; font-family: var(--dl-font-heading); font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); background: none; border: none; cursor: pointer; padding: 0.5rem 0; border-bottom: 1px solid transparent; transition: all 0.3s; white-space: nowrap; }
  .dl-cat-btn:hover, .dl-cat-btn.active { color: var(--dl-gold); border-bottom-color: var(--dl-gold); }
</style>
<script>
  document.addEventListener('astro:page-load', function() {
    var nav = document.querySelector('.dl-cat-track');
    if (!nav) return;
    var btns = nav.querySelectorAll('.dl-cat-btn');
    var secs = document.querySelectorAll('section[id^="category-"]');
    btns.forEach(function(b) { b.addEventListener('click', function() { var t = document.getElementById('category-' + b.dataset.category); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); });
    var obs = new IntersectionObserver(function(entries) { entries.forEach(function(e) { if (e.isIntersecting) { var id = e.target.id.replace('category-', ''); btns.forEach(function(b) { var a = b.dataset.category === id; b.classList.toggle('active', a); }); } }); }, { rootMargin: '-20% 0px -60% 0px', threshold: 0.1 });
    secs.forEach(function(s) { obs.observe(s); });
  });
</script>