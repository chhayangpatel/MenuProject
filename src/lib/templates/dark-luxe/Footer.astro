---
import type { Restaurant } from '../../../schemas/restaurant.schema';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const { hours, contact } = restaurant;
const hourEntries = hours?.regular ? Object.entries(hours.regular) : [];
---
<footer class="dl-footer">
  <div class="dl-footer-inner">
    <p class="dl-footer-name">{restaurant.name}</p>
    {restaurant.tagline && <p class="dl-footer-tagline">{restaurant.tagline}</p>}
    <div class="dl-footer-divider"></div>
    <div class="dl-footer-info">
      {hourEntries.length > 0 && (
        <div class="dl-footer-col">
          <h4>Hours</h4>
          {hourEntries.map(([d,t]) => <p><span>{d}</span> {t}</p>)}
        </div>
      )}
      <div class="dl-footer-col">
        <h4>Contact</h4>
        {contact?.address && <p>{contact.address}</p>}
        {contact?.phone && <p>{contact.phone}</p>}
        {contact?.email && <p>{contact.email}</p>}
      </div>
    </div>
    <p class="dl-footer-copy">© {new Date().getFullYear()} {restaurant.name}</p>
  </div>
</footer>
<style>
  .dl-footer { padding: 4rem 2rem 2rem; text-align: center; }
  .dl-footer-name { font-family: var(--dl-font-heading); font-size: 1.5rem; font-weight: 300; letter-spacing: 0.15em; text-transform: uppercase; color: #fff; }
  .dl-footer-tagline { color: rgba(255,255,255,0.4); font-style: italic; margin: 0.5rem 0 2rem; }
  .dl-footer-divider { width: 60px; height: 1px; background: var(--dl-gold); margin: 0 auto 2rem; }
  .dl-footer-info { display: flex; justify-content: center; gap: 4rem; margin-bottom: 2rem; }
  .dl-footer-col h4 { font-size: 0.625rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dl-gold); margin-bottom: 0.75rem; }
  .dl-footer-col p { font-size: 0.8125rem; color: rgba(255,255,255,0.5); margin-bottom: 0.25rem; }
  .dl-footer-col p span { color: rgba(255,255,255,0.7); text-transform: capitalize; }
  .dl-footer-copy { font-size: 0.6875rem; color: rgba(255,255,255,0.2); }
</style>