---
/**
 * Newspaper Editorial — FeaturedCarousel → "The Editor's Table"
 *
 * Deliberately not a carousel: a restrained editorial spread of the dishes the
 * restaurant itself marked as featured. Photographs appear when the dish has
 * one; otherwise the block stays pure typography. Rendered by the page only
 * when at least one featured dish exists.
 */
import type { MenuItem, Restaurant } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';

interface Props {
  items: MenuItem[];
  currencySymbol?: string;
  showPrices?: boolean;
  restaurant: Restaurant;
}

const { items = [], currencySymbol = '$', showPrices = true, restaurant } = Astro.props;

const featured = items.map((item) => {
  const variantPrices = (item.variants ?? []).map(
    (variant) => item.price + (variant.priceModifier ?? 0),
  );
  const hasVariantPricing = variantPrices.length > 1;
  const leadPrice = hasVariantPricing ? Math.min(...variantPrices) : item.price;

  return {
    id: item.id,
    name: item.name,
    description: item.description ?? '',
    image: item.image ? resolveMenuItemImage(restaurant, item.image) : '',
    hasVariantPricing,
    priceLabel: `${currencySymbol}${leadPrice.toFixed(2)}`,
  };
});
---

<section class="ne-editors" aria-labelledby="ne-editors-title">
  <p class="ne-editors-label">
    <span class="ne-editors-label-rule" aria-hidden="true" />
    <span>From the Kitchen</span>
  </p>

  <h2 id="ne-editors-title" class="ne-editors-title">The Editor&rsquo;s Table</h2>

  <div class="ne-editors-grid">
    {
      featured.map((item) => (
        <article class="ne-editors-item">
          {item.image && (
            <figure class="ne-editors-plate">
              <img
                class="ne-editors-img"
                src={item.image}
                alt={item.name}
                loading="lazy"
                decoding="async"
              />
            </figure>
          )}

          <div class="ne-editors-body">
            <div class="ne-editors-line">
              <h3 class="ne-editors-name">{item.name}</h3>
              {showPrices && (
                <span class="ne-editors-price">
                  {item.hasVariantPricing && (
                    <span class="ne-editors-from">from</span>
                  )}
                  {item.priceLabel}
                </span>
              )}
            </div>
            {item.description && (
              <p class="ne-editors-desc">{item.description}</p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .ne-editors {
    max-width: var(--ne-measure);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--ne-gutter) 0;
  }

  .ne-editors-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--ne-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ne-accent, #7d3037);
  }

  .ne-editors-label-rule {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .ne-editors-title {
    margin-top: 0.6rem;
    font-family: var(--ne-serif);
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--ne-ink);
    text-wrap: balance;
  }

  .ne-editors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    padding-top: clamp(1.5rem, 4vw, 2.25rem);
    border-top: var(--ne-double-rule);
  }

  .ne-editors-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .ne-editors-plate {
    margin: 0;
  }

  .ne-editors-img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: var(--ne-rule-soft);
    background: var(--ne-wash);
    filter: saturate(0.9) contrast(1.03);
  }

  .ne-editors-line {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .ne-editors-name {
    flex: 1;
    font-family: var(--ne-serif);
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ne-ink);
  }

  .ne-editors-price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-shrink: 0;
    font-family: var(--ne-mono);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--ne-ink);
    white-space: nowrap;
  }

  .ne-editors-from {
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ne-muted);
  }

  .ne-editors-desc {
    margin-top: 0.5rem;
    max-width: 52ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--ne-muted);
  }

  /* A single featured dish becomes a two-column spread: plate + column */
  @media (min-width: 860px) {
    .ne-editors-grid:has(> .ne-editors-item:only-child) .ne-editors-item {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(1.75rem, 4vw, 3rem);
      align-items: center;
    }

    .ne-editors-grid:has(> .ne-editors-item:only-child) .ne-editors-desc {
      max-width: 46ch;
    }
  }
</style>
