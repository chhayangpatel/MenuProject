---
/**
 * Modern Dark — Header
 * Slim fixed bar that slides in after the hero scrolls past. Name on the
 * left; phone / map / menu links on the right. 44px touch targets.
 */
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveLogo } from '../../../lib/assets';

interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const logoUrl = resolveLogo(restaurant);
const phone = restaurant.contact?.phone;
const mapsUrl = restaurant.contact?.googleMapsUrl;
---

<nav class="nr-header" id="nr-header" aria-label="Restaurant">
  <a href="#top" class="nr-header-brand">
    {logoUrl && <img src={logoUrl} alt="" class="nr-header-logo" loading="lazy" />}
    <span class="nr-header-name">{restaurant.name}</span>
  </a>
  <div class="nr-header-actions">
    {phone && (
      <a href={`tel:${phone.replace(/[^+\d]/g, "")}`} class="nr-header-link" aria-label={`Call ${restaurant.name}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span class="nr-header-link-text">Call</span>
      </a>
    )}
    {mapsUrl && (
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="nr-header-link" aria-label={`Find ${restaurant.name} on the map`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span class="nr-header-link-text">Find us</span>
      </a>
    )}
    <a href="#menu" class="nr-header-menu">Menu</a>
  </div>
</nav>

<style>
  .nr-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 0.5rem clamp(1rem, 4vw, 2.5rem);
    background: color-mix(in srgb, var(--nr-secondary, #101110) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--nr-border, rgba(245, 241, 232, 0.1));
    transform: translateY(-100%);
    transition: transform 0.4s var(--mr-ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .nr-header.is-visible {
    transform: translateY(0);
  }

  .nr-header-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--nr-primary, #f5f1e8);
    min-height: 44px;
  }

  .nr-header-logo {
    width: 28px;
    height: 28px;
    object-fit: cover;
    border: 1px solid var(--nr-border-strong, rgba(245, 241, 232, 0.22));
    border-radius: 2px;
  }

  .nr-header-name {
    font-family: var(--nr-font-heading);
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
  }

  .nr-header-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }

  .nr-header-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-family: var(--nr-font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--nr-muted, #aba39f);
    transition: color 0.25s ease;
  }

  .nr-header-link:hover {
    color: var(--nr-accent, #c6aa78);
  }

  .nr-header-menu {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.4rem 1.1rem;
    border: 1px solid var(--nr-accent, #c6aa78);
    border-radius: 2px;
    font-family: var(--nr-font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--nr-accent, #c6aa78);
    transition: background 0.3s ease, color 0.3s ease;
  }

  .nr-header-menu:hover {
    background: var(--nr-accent, #c6aa78);
    color: var(--mr-on-accent, #111111);
  }

  @media (max-width: 480px) {
    .nr-header-link-text {
      display: none;
    }
  }
</style>

<script>
  // Slide the header in after the hero has scrolled past. Idempotent.
  function setupNrHeader() {
    const header = document.getElementById('nr-header');
    if (!header || header.dataset.nrHeaderAttached) return;
    header.dataset.nrHeaderAttached = 'true';

    const hero = document.querySelector<HTMLElement>('.nr-hero');
    const threshold = hero ? hero.offsetHeight * 0.65 : 480;

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        header.classList.toggle('is-visible', window.scrollY > threshold);
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener('astro:page-load', setupNrHeader);
  if (document.readyState !== 'loading') setupNrHeader();
</script>
