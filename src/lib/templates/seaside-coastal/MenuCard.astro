---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
import ItemBadge from '../../../components/ItemBadge.astro';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { item, currencySymbol='$', showPrices=true, restaurant } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<div class="sc-item">
  <div class="sc-item-card">
    {hasImage && <div class="sc-item-img"><img src={imageUrl} alt={item.name} loading="lazy" /></div>}
    <div class="sc-item-info">
      <div class="sc-item-title-wrap">
        <h3 class="sc-item-name">{item.name}</h3>
        <ItemBadge item={item} size="sm" />
      </div>
      {item.description && <p class="sc-item-desc">{item.description}</p>}
      <div class="sc-item-bottom">
        <div class="sc-item-tags">
          {isVeg && !isVegan && <span class="sc-tag sc-tag--veg">Veg</span>}
          {isVegan && <span class="sc-tag sc-tag--vegan">Vegan</span>}
          {isGF && <span class="sc-tag sc-tag--gf">GF</span>}
        </div>
        <span class="sc-item-price">{currencySymbol}{item.price.toFixed(2)}</span>
      </div>
    </div>
  </div>
</div>
<style>
  .sc-item { padding: 0.75rem 1.5rem; }
  .sc-item-card { display: flex; gap: 1.25rem; padding: 1.25rem; background: #fff; border-radius: 1.5rem; box-shadow: 0 4px 20px -4px rgba(0,0,0,0.06); transition: transform 0.3s, box-shadow 0.3s; }
  .sc-item-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px -8px rgba(0,0,0,0.1); }
  .sc-item-img { flex-shrink: 0; width: 90px; height: 90px; border-radius: 1rem; overflow: hidden; }
  .sc-item-img img { width: 100%; height: 100%; object-fit: cover; }
  .sc-item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .sc-item-title-wrap { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 0.25rem; }
  .sc-item-name { font-family: var(--sc-font-heading); font-size: 1.0625rem; font-weight: 500; color: var(--sc-primary); line-height: 1.3; }
  .sc-item-desc { font-family: var(--sc-font-body); font-size: 0.8125rem; color: rgba(0,0,0,0.5); line-height: 1.5; margin-bottom: 0.5rem; }
  .sc-item-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
  .sc-item-price { font-family: var(--sc-font-body); font-weight: 700; font-size: 1rem; color: var(--sc-accent); white-space: nowrap; flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .sc-item-tags { display: flex; gap: 0.375rem; }
  .sc-tag { font-size: 0.5rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; }
  .sc-tag--veg { background: #e0f2f1; color: #00695C; }
  .sc-tag--vegan { background: #e0f2f1; color: #00695C; }
  .sc-tag--gf { background: #fff3e0; color: #E65100; }
</style>