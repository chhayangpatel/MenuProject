---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import MenuCard from './MenuCard.astro';
interface Props { items: MenuItem[]; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { items, currencySymbol, showPrices, restaurant } = Astro.props;
---
<section class="sc-featured">
  <h2 class="sc-featured-title">Fresh Catches</h2>
  <div class="sc-featured-grid">
    {items.map(item => (
      <MenuCard item={item} currencySymbol={currencySymbol} showPrices={showPrices} restaurant={restaurant} />
    ))}
  </div>
</section>
<style>
  .sc-featured { padding: 3rem 0; }
  .sc-featured-title { font-family: var(--sc-font-heading); font-size: 1.5rem; font-weight: 400; color: var(--sc-primary); text-align: center; margin-bottom: 2rem; }
  .sc-featured-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0; padding: 0 1.5rem; }
</style>