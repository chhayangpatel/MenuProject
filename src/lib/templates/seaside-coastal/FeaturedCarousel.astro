---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import MenuCard from './MenuCard.astro';
interface Props { items: MenuItem[]; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { items, currencySymbol, showPrices, restaurant } = Astro.props;
const featured = items.slice(0, 4);
---
<section class="sc-featured">
  <div class="sc-featured-header">
    <h2 class="sc-featured-title">Fresh Catches</h2>
    <p class="sc-featured-subline">Today's best — straight from the dock to your plate</p>
  </div>
  <div class="sc-featured-grid" role="list" aria-label="Featured items">
    {featured.map(item => (
      <div class="sc-featured-card" role="listitem">
        <MenuCard item={item} currencySymbol={currencySymbol} showPrices={showPrices} restaurant={restaurant} />
      </div>
    ))}
  </div>
</section>
<style>
  .sc-featured { padding: 3rem 0; }
  .sc-featured-header { text-align: center; margin-bottom: 2rem; padding: 0 1.5rem; }
  .sc-featured-title { font-family: var(--sc-font-heading); font-size: 1.5rem; font-weight: 400; color: var(--sc-primary); margin: 0 0 0.5rem; }
  .sc-featured-subline { font-family: var(--sc-font-body); font-size: 0.875rem; color: rgba(0,0,0,0.5); margin: 0; }
  .sc-featured-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; padding: 0 1.5rem; align-items: stretch; }
  .sc-featured-card { display: flex; flex-direction: column; height: 100%; }
  @media (min-width: 540px) { .sc-featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .sc-featured-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>