---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import Footer from '../../../components/Footer.astro';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
---

<div class="sc-footer-wrapper">
  <svg class="sc-footer-wave" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,20 1440,40 L1440,100 L0,100 Z" fill="color-mix(in srgb, var(--color-primary) 4%, var(--color-secondary))"/>
  </svg>
  <Footer restaurant={restaurant} />
</div>

<style>
  .sc-footer-wrapper {
    position: relative;
    width: 100%;
    margin-top: 3rem;
  }
  .sc-footer-wave {
    position: absolute;
    top: -45px;
    left: 0;
    right: 0;
    width: 100%;
    height: 50px;
    pointer-events: none;
  }
</style>