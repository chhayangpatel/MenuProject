---
import type { MenuCategory } from '../../../schemas/restaurant.schema';
import { resolveCategoryHeroImage } from '../../../lib/assets';
interface Props { category: MenuCategory; slug: string; categoryIndex: number; restaurant: any; }
const { category, categoryIndex, restaurant } = Astro.props;
const imageUrl = resolveCategoryHeroImage(restaurant, category.heroImage);
---
<div class="sc-cat-header">
  <span class="sc-cat-num">{String(categoryIndex + 1).padStart(2, '0')}</span>
  <h2 class="sc-cat-title">{category.name}</h2>
  {category.description && <p class="sc-cat-desc">{category.description}</p>}
</div>
<style>
  .sc-cat-header { text-align: center; padding: 3rem 2rem 1.5rem; }
  .sc-cat-num { font-family: var(--sc-font-heading); font-size: 0.75rem; color: var(--sc-accent); letter-spacing: 0.2em; }
  .sc-cat-title { font-family: var(--sc-font-heading); font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 400; color: var(--sc-primary); margin: 0.5rem 0; }
  .sc-cat-desc { font-family: var(--sc-font-body); font-size: 0.9375rem; color: rgba(0,0,0,0.5); max-width: 40ch; margin: 0 auto; }
</style>