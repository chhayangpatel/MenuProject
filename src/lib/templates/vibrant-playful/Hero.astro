---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveCover, resolveLogo } from '../../../lib/assets';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const hasCover = !!restaurant.coverImage;
const coverUrl = resolveCover(restaurant);
const logoUrl = resolveLogo(restaurant);
---
<div class="vp-wrapper vp-hero-wrapper">
  {hasCover && (
    <>
      <img src={coverUrl} alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--vp-secondary)]"></div>
    </>
  )}
  <div class="relative z-10 w-full max-w-3xl mx-auto px-6 text-center">
    <div class="vp-logo-ring mb-8 mx-auto" style="width:100px;height:100px;border-radius:50%;padding:5px;background:linear-gradient(135deg,var(--vp-accent),var(--vp-accent-3) 60%);box-shadow:0 0 0 1px rgba(0,0,0,0.05),0 16px 64px rgba(255,138,101,0.2);animation:vp-pulse 2s ease-in-out infinite;">
      <img src={logoUrl} alt={restaurant.name} style="width:100%;height:100%;border-radius:50%;object-fit:cover;background:var(--vp-secondary);" />
    </div>
    <h1 class="vp-hero-title">{restaurant.name}</h1>
    {restaurant.tagline && <p class="vp-hero-tagline">{restaurant.tagline}</p>}
    <a href="#menu" class="vp-btn vp-btn-primary">Explore Menu <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
  </div>
</div>
<style>
  .vp-logo-ring { animation: vp-pulse-ring 2s ease-in-out infinite; }
  @keyframes vp-pulse-ring { 0%,100% { box-shadow:0 0 0 1px rgba(0,0,0,0.05),0 16px 64px rgba(255,138,101,0.2); } 50% { box-shadow:0 0 0 1px rgba(0,0,0,0.05),0 20px 80px rgba(255,138,101,0.4); } }
</style>