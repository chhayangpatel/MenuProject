---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveCover, resolveLogo } from '../../../lib/assets';
import HeroStory from '../../../components/HeroStory.astro';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const heroStyle = restaurant.hero?.style || 'fullbleed';
const hasCover = !!restaurant.coverImage;
const coverUrl = resolveCover(restaurant);
const logoUrl = resolveLogo(restaurant);
---

<div class="vp-hero-wrapper" style={hasCover && heroStyle !== 'minimal' ? 'min-height: 70vh;' : 'padding: 5rem 1.5rem 3rem;'}>
  {hasCover && heroStyle !== 'minimal' && (
    <>
      <img src={coverUrl} alt="" class="vp-hero-bg" loading="eager" />
      <div class="vp-hero-scrim"></div>
    </>
  )}
  <div class="vp-hero-content relative z-10 w-full max-w-3xl mx-auto px-6 text-center">
    <div class="vp-logo-ring mb-8 mx-auto">
      <img src={logoUrl} alt={restaurant.name} class="vp-logo-img" />
    </div>
    <h1 class={"vp-hero-title " + (hasCover && heroStyle !== 'minimal' ? 'vp-text-light' : 'vp-text-dark')}>
      {restaurant.name}
    </h1>
    <div class="vp-divider" aria-hidden="true"></div>
    {restaurant.tagline && (
      <p class={"vp-hero-tagline " + (hasCover && heroStyle !== 'minimal' ? 'vp-text-light' : 'vp-text-dark')}>
        {restaurant.tagline}
      </p>
    )}
    <HeroStory restaurant={restaurant} light={hasCover && heroStyle !== 'minimal'} />
    <a href="#menu" class="vp-btn vp-btn-primary">Explore Menu <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
    {hasCover && heroStyle === 'fullbleed' && (
      <div class="vp-scroll-cue mt-8">
        <span class="vp-scroll-dot"></span>
        <span class="vp-scroll-text">Scroll to explore</span>
      </div>
    )}
  </div>
</div>

<style>
  .vp-hero-wrapper {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .vp-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vp-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  .vp-hero-content {
    padding-bottom: 3rem;
    padding-top: 5rem;
    animation: vp-contentUp 0.8s ease-out both;
  }

  @keyframes vp-contentUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .vp-logo-ring {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, var(--vp-accent), var(--vp-accent-3, var(--vp-accent)) 60%);
    box-shadow: 0 0 0 1px rgba(0,0,0,0.05), 0 12px 48px rgba(0,0,0,0.15);
    animation: vp-logoPop 0.7s ease-out 0.2s both;
  }

  @keyframes vp-logoPop {
    from { opacity: 0; transform: scale(0.7); }
    to   { opacity: 1; transform: scale(1); }
  }

  .vp-logo-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--vp-secondary);
  }

  .vp-hero-title {
    font-family: var(--vp-font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
    text-shadow: 0 4px 24px rgba(0,0,0,0.5);
  }

  .vp-text-light { color: #fff; }
  .vp-text-dark  { color: var(--vp-primary); }

  .vp-divider {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--vp-accent), transparent);
    margin: 1rem auto 1.25rem;
    animation: vp-dividerGrow 0.6s ease-out 0.5s both;
  }

  @keyframes vp-dividerGrow {
    from { width: 0; opacity: 0; }
    to   { width: 60px; opacity: 1; }
  }

  .vp-hero-tagline {
    font-family: var(--vp-font-body);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    max-width: 40ch;
    margin: 0 auto 1.5rem;
    animation: vp-contentUp 0.8s ease-out 0.1s both;
  }

  .vp-scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0.6;
    animation: vp-contentUp 0.8s ease-out 0.8s both;
  }

  .vp-scroll-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--vp-accent);
    animation: vp-scrollBounce 2s ease-in-out infinite;
  }

  .vp-scroll-text {
    font-family: var(--vp-font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vp-accent);
  }

  @keyframes vp-scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50%       { transform: translateY(8px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vp-hero-content, .vp-logo-ring, .vp-hero-tagline, .vp-divider, .vp-scroll-cue {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>