---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import Footer from '../../../components/Footer.astro';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
---

<div class="vp-footer-wrapper">
  <Footer restaurant={restaurant} />
</div>

<style>
  .vp-footer-wrapper {
    width: 100%;
  }
</style>
