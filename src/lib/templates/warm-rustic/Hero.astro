---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveCover, resolveLogo } from '../../../lib/assets';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const hasCover = !!restaurant.coverImage;
const coverUrl = resolveCover(restaurant);
const logoUrl = resolveLogo(restaurant);
---
<div class="wr-wrapper wr-hero-wrapper">
  {hasCover && (
    <>
      <img src={coverUrl} alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--wr-cream)]/90 via-transparent to-transparent"></div>
    </>
  )}
  <div class="relative z-10 w-full max-w-3xl mx-auto px-6 text-center">
    <div class="wr-logo-ring mb-8 mx-auto" style="width:90px;height:90px;border-radius:50%;padding:4px;background:linear-gradient(135deg,var(--wr-gold),var(--wr-accent) 60%);box-shadow:0 0 0 1px rgba(0,0,0,0.05),0 12px 48px rgba(45,27,16,0.15);">
      <img src={logoUrl} alt={restaurant.name} style="width:100%;height:100%;border-radius:50%;object-fit:cover;background:var(--wr-cream);" />
    </div>
    <h1 class="wr-hero-title">{restaurant.name}</h1>
    {restaurant.tagline && <p class="wr-hero-tagline">"{restaurant.tagline}"</p>}
  </div>
</div>
<style>
  .wr-logo-ring { animation: wr-pop 1s var(--wr-ease-spring) 0.3s both; }
  @keyframes wr-pop { from { opacity:0; transform:scale(0.6); } to { opacity:1; transform:scale(1); } }
</style>