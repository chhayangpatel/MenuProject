---
import type { Restaurant } from '../../../schemas/restaurant.schema';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const { hours, contact } = restaurant;
const hourEntries = hours?.regular ? Object.entries(hours.regular) : (hours && !hours.regular ? Object.entries(hours as Record<string,string>) : []);
---
<footer class="wr-footer">
  <div class="wr-divider"></div>
  <p style="font-family:var(--wr-font-heading);font-weight:700;font-size:1.5rem;letter-spacing:-0.01em;color:var(--wr-primary);">{restaurant.name}</p>
  {restaurant.tagline && <p style="color:#5D4A3A;font-style:italic;margin:0.5rem auto 1.5rem;max-width:36ch;">{restaurant.tagline}</p>}
  <div class="wr-divider"></div>
  <div style="display:flex;flex-direction:column;gap:2rem;text-align:center;">
    {hourEntries.length>0 && <div><h4 style="font-size:0.625rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--wr-gold);margin-bottom:0.5rem;">HOURS</h4><ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.375rem;">{hourEntries.map(([d,t])=>(<li style="display:flex;justify-content:space-between;gap:1rem;color:#5D4A3A;font-size:0.8125rem;"><span style="font-weight:500;color:var(--wr-primary);text-transform:capitalize;">{d}</span><span>{t}</span></li>))}</ul></div>}
    <div><h4 style="font-size:0.625rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--wr-gold);margin-bottom:0.5rem;">LOCATION</h4>{contact?.address && <p style="color:#5D4A3A;line-height:1.6;margin-bottom:0.5rem;">{contact.address}</p>}{contact?.googleMapsUrl && <a href={contact.googleMapsUrl} target="_blank" rel="noopener" style="color:var(--wr-accent);font-weight:600;font-size:0.8125rem;">GET DIRECTIONS</a>}{contact?.phone && <a href={"tel:"+contact.phone} style="display:block;color:#5D4A3A;margin-top:0.25rem;">{contact.phone}</a>}{contact?.email && <a href={"mailto:"+contact.email} style="display:block;color:#5D4A3A;margin-top:0.25rem;">{contact.email}</a>}</div>
  </div>
  <div class="wr-divider" style="margin-top:2rem;"></div>
  <p style="font-size:0.75rem;color:rgba(45,27,16,0.3);">© {new Date().getFullYear()} {restaurant.name}</p>
</footer>