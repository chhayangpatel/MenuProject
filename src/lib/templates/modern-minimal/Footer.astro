---
import type { Restaurant } from '../../../schemas/restaurant.schema';
interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const { hours, contact } = restaurant;
const hourEntries = hours?.regular ? Object.entries(hours.regular) : (hours && !hours.regular ? Object.entries(hours as Record<string,string>) : []);
---
<footer class="mm-footer">
  <p style="font-family:var(--mm-font-heading);font-weight:700;color:var(--mm-primary);margin-bottom:0.5rem;">{restaurant.name}</p>
  {restaurant.tagline && <p style="color:var(--mm-warm-grey);font-style:italic;margin-bottom:1.5rem;">{restaurant.tagline}</p>}
  <div class="mm-divider"></div>
  <div style="display:flex;flex-direction:column;gap:2rem;text-align:center;">
    {hourEntries.length>0 && <div><h4 style="font-size:0.625rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--mm-warm-grey);margin-bottom:0.5rem;">Hours</h4><ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.375rem;">{hourEntries.map(([d,t])=>(<li style="display:flex;justify-content:space-between;gap:1rem;color:var(--mm-warm-grey);font-size:0.8125rem;"><span style="font-weight:500;color:var(--mm-primary);text-transform:capitalize;">{d}</span><span>{t}</span></li>))}</ul></div>}
    <div><h4 style="font-size:0.625rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--mm-warm-grey);margin-bottom:0.5rem;">Location</h4>{contact?.address && <p style="color:var(--mm-warm-grey);line-height:1.6;margin-bottom:0.5rem;">{contact.address}</p>}{contact?.googleMapsUrl && <a href={contact.googleMapsUrl} target="_blank" rel="noopener" style="color:var(--mm-accent);font-weight:600;font-size:0.8125rem;">Get Directions</a>}{contact?.phone && <a href={"tel:"+contact.phone} style="display:block;color:var(--mm-warm-grey);margin-top:0.25rem;">{contact.phone}</a>}{contact?.email && <a href={"mailto:"+contact.email} style="display:block;color:var(--mm-warm-grey);margin-top:0.25rem;">{contact.email}</a>}</div>
  </div>
  <div class="mm-divider" style="margin-top:2rem;"></div>
  <p style="font-size:0.75rem;color:rgba(26,26,26,0.35);">© {new Date().getFullYear()} {restaurant.name}</p>
</footer>