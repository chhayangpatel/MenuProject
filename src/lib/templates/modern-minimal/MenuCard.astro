---
import type { MenuItem } from '../../../schemas/restaurant.schema';
import { resolveMenuItemImage } from '../../../lib/assets';
import ItemBadge from '../../../components/ItemBadge.astro';
interface Props { item: MenuItem; currencySymbol?: string; showPrices?: boolean; restaurant: any; }
const { item, currencySymbol='$', showPrices=true, restaurant } = Astro.props;
const hasImage = !!item.image;
const imageUrl = hasImage ? resolveMenuItemImage(restaurant, item.image) : '';
const isVeg = item.tags.includes('vegetarian'), isVegan = item.tags.includes('vegan'), isGF = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---
<article class="mm-card-outer" data-item-id={item.id} role="button" tabindex="0" aria-label={"View "+item.name}>
  <div class="mm-card">
    <div class="mm-card-body">
      <div class="mm-card-text">
        <div class="mm-card-header">
          <div class="mm-card-title-wrap">
            <h3 class="mm-item-name">{item.name}</h3>
            <ItemBadge item={item} size="sm" />
          </div>
          {showPrices && <span class="mm-item-price">{hasVariants?'From ':''}{currencySymbol}{item.price.toFixed(2)}</span>}
        </div>
        {item.description && <p class="mm-item-desc">{item.description}</p>}
        <div class="mm-card-tags">
          {isVeg && !isVegan && <span class="mm-tag mm-tag--veg">🌿 Veg</span>}
          {isVegan && <span class="mm-tag mm-tag--vegan">🌱 Vegan</span>}
          {isGF && <span class="mm-tag mm-tag--gf">GF</span>}
          {item.spicyLevel>0 && <span class="mm-tag mm-tag--spicy">{"🌶️".repeat(item.spicyLevel)}</span>}
        </div>
      </div>
      {hasImage && <div class="mm-card-img-wrap"><img src={imageUrl} alt={item.name} class="mm-card-img" loading="lazy" /></div>}
    </div>
  </div>
</article>

<style>
  .mm-card-outer {
    padding: 0.75rem 0;
  }
  .mm-card {
    background: transparent;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 1rem 0;
    transition: background 0.2s ease;
  }
  .mm-card:hover {
    background: rgba(0,0,0,0.02);
  }
  .mm-card-body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .mm-card-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .mm-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .mm-card-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 1;
    min-width: 0;
  }
  .mm-item-name {
    font-family: var(--mm-font-heading);
    font-size: 1rem;
    font-weight: 500;
    color: var(--mm-primary);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .mm-item-price {
    font-family: var(--mm-font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--mm-accent);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .mm-item-desc {
    font-family: var(--mm-font-body);
    font-size: 0.8125rem;
    color: rgba(0,0,0,0.5);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }
  .mm-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }
  .mm-tag {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .mm-tag--veg {
    background: #dcfce7;
    color: #15803d;
  }
  .mm-tag--vegan {
    background: #dcfce7;
    color: #15803d;
  }
  .mm-tag--gf {
    background: #fef3c7;
    color: #b45309;
  }
  .mm-tag--spicy {
    background: #fee2e2;
    color: #b91c1c;
  }
  .mm-card-img-wrap {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
  }
  .mm-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>