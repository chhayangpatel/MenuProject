---
import type { MenuCategory } from '../../../schemas/restaurant.schema';
interface Props { categories: MenuCategory[]; }
const { categories } = Astro.props;
---
<nav class="mm-category-nav" aria-label="Menu categories">
  <div class="mm-category-nav-inner" id="mm-category-nav">
    {categories.map((cat,i)=>(<button class="mm-category-btn" data-category={cat.id} role="tab" aria-selected={i===0}>{cat.name}</button>))}
  </div>
</nav>
<script>
  document.addEventListener('astro:page-load', function() {
    const nav = document.getElementById('mm-category-nav');
    if (!nav) return;
    const btns = nav.querySelectorAll('.mm-category-btn');
    const secs = document.querySelectorAll('section[id^="category-"]');
    btns.forEach(function(b) {
      b.addEventListener('click', function() {
        const t = document.getElementById('category-' + b.dataset.category);
        if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    const obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          const id = e.target.id.replace('category-', '');
          btns.forEach(function(b) {
            const a = b.dataset.category === id;
            b.classList.toggle('active', a);
            b.setAttribute('aria-selected', String(a));
          });
        }
      });
    }, { rootMargin: '-20% 0px -60% 0px', threshold: 0.1 });
    secs.forEach(function(s) { obs.observe(s); });
  });
</script>