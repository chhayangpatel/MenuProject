---
import type { Restaurant } from '../../../schemas/restaurant.schema';
import { resolveCover, resolveLogo } from '../../../lib/assets';
import HeroStory from '../../../components/HeroStory.astro';

interface Props { restaurant: Restaurant; }
const { restaurant } = Astro.props;
const heroStyle = restaurant.hero?.style || 'fullbleed';
const hasCover = !!restaurant.coverImage;
const coverUrl = resolveCover(restaurant);
const logoUrl = resolveLogo(restaurant);
---

<div class="mm-hero-wrapper" style={hasCover && heroStyle !== 'minimal' ? 'min-height: 70vh;' : 'padding: 5rem 1.5rem 3rem;'}>
  {hasCover && heroStyle !== 'minimal' && (
    <>
      <img src={coverUrl} alt="" class="mm-hero-bg" loading="eager" />
      <div class="mm-hero-scrim"></div>
    </>
  )}
  <div class="mm-hero-content relative z-10 w-full text-center px-6">
    <div class="mm-logo-ring mb-6 mx-auto">
      <img src={logoUrl} alt={restaurant.name} class="mm-logo-img" />
    </div>
    <h1 class={"mm-hero-title " + (hasCover && heroStyle !== 'minimal' ? 'mm-text-light' : 'mm-text-dark')}>
      {restaurant.name}
    </h1>
    <div class="mm-divider" aria-hidden="true"></div>
    {restaurant.tagline && (
      <p class={"mm-hero-tagline " + (hasCover && heroStyle !== 'minimal' ? 'mm-text-light' : 'mm-text-dark')}>
        {restaurant.tagline}
      </p>
    )}
    <HeroStory restaurant={restaurant} light={hasCover && heroStyle !== 'minimal'} />
    {hasCover && heroStyle === 'fullbleed' && (
      <div class="mm-scroll-cue mt-8">
        <span class="mm-scroll-dot"></span>
        <span class="mm-scroll-text">Scroll to explore</span>
      </div>
    )}
  </div>
</div>

<style>
  .mm-hero-wrapper {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .mm-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.35) 50%,
      rgba(0, 0, 0, 0.08) 100%
    );
  }

  .mm-hero-content {
    padding-bottom: 3.5rem;
    padding-top: 5rem;
    animation: mm-contentUp 0.8s ease-out both;
  }

  @keyframes mm-contentUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mm-logo-ring {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--mm-accent), transparent 60%);
    box-shadow: 0 0 0 1px rgba(0,0,0,0.05), 0 8px 32px rgba(0,0,0,0.1);
    animation: mm-logoPop 0.7s ease-out 0.2s both;
  }

  @keyframes mm-logoPop {
    from { opacity: 0; transform: scale(0.7); }
    to   { opacity: 1; transform: scale(1); }
  }

  .mm-logo-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--mm-secondary);
  }

  .mm-hero-title {
    font-family: var(--mm-font-heading);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 16px rgba(0,0,0,0.4);
  }

  .mm-text-light { color: #fff; }
  .mm-text-dark  { color: var(--mm-primary); }

  .mm-divider {
    width: 60px;
    height: 1.5px;
    background: linear-gradient(90deg, transparent, var(--mm-accent), transparent);
    margin: 1rem auto 1.25rem;
    animation: mm-dividerGrow 0.6s ease-out 0.5s both;
  }

  @keyframes mm-dividerGrow {
    from { width: 0; opacity: 0; }
    to   { width: 60px; opacity: 1; }
  }

  .mm-hero-tagline {
    font-family: var(--mm-font-body);
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    max-width: 36ch;
    line-height: 1.6;
    margin: 0 auto;
    animation: mm-contentUp 0.8s ease-out 0.1s both;
  }

  .mm-scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0.6;
    animation: mm-contentUp 0.8s ease-out 0.8s both;
  }

  .mm-scroll-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mm-accent);
    animation: mm-scrollBounce 2s ease-in-out infinite;
  }

  .mm-scroll-text {
    font-family: var(--mm-font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mm-accent);
  }

  @keyframes mm-scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50%       { transform: translateY(8px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-hero-content, .mm-logo-ring, .mm-hero-tagline, .mm-divider, .mm-scroll-cue {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>