---
import { loadAllRestaurants } from '../lib/loadRestaurants';
import '../styles/global.css';

const restaurants = await loadAllRestaurants();

// Build cover/logo URLs for each restaurant
const cards = restaurants.map(r => ({
  r,
  coverUrl: r.coverImage
    ? (r.coverImage.startsWith('http') ? r.coverImage : '/r/' + r.slug + '/assets/' + r.coverImage)
    : null,
  logoUrl: r.logo.startsWith('http') ? r.logo : '/r/' + r.slug + '/assets/' + r.logo,
  href: '/r/' + r.slug + '/',
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Restaurant Directory | Digital Menus</title>
    <meta name="description" content="Browse our partner restaurants and explore their digital menus." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
    </style>
  </head>

  <body class="dir-body">
    {/* Ambient blobs */}
    <div class="blob blob-1" aria-hidden="true"></div>
    <div class="blob blob-2" aria-hidden="true"></div>

    <div class="dir-container">
      {/* Header */}
      <header class="dir-header">
        <div class="dir-header-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          {restaurants.length} Restaurant{restaurants.length !== 1 ? 's' : ''}
        </div>
        <h1 class="dir-headline">
          <span class="dir-headline-top">Discover</span>
          <span class="dir-headline-bottom">Our Restaurants</span>
        </h1>
        <p class="dir-subheadline">Tap any restaurant to explore its full digital menu</p>
      </header>

      {/* Grid */}
      <main class="dir-grid" id="restaurant-grid">
        {cards.map(({ r, coverUrl, logoUrl, href }) => (
          <a href={href} class="rcard" id={"rcard-" + r.slug} aria-label={"View " + r.name + " menu"}>
            {/* Cover */}
            <div class="rcard-cover">
              {coverUrl ? (
                <img src={coverUrl} alt="" class="rcard-cover-img" loading="lazy" decoding="async" />
              ) : (
                <div class="rcard-cover-placeholder" style={"background: " + r.theme.primaryColor + "22;"}></div>
              )}
              <div class="rcard-cover-scrim"></div>

              {/* Mood badge */}
              <span class="rcard-mood-badge">{r.moodPreset.replace('-', ' ')}</span>
            </div>

            {/* Body */}
            <div class="rcard-body">
              {/* Logo */}
              <div class="rcard-logo-wrap">
                <img src={logoUrl} alt="" class="rcard-logo" />
              </div>

              <div class="rcard-text">
                <h2 class="rcard-name">{r.name}</h2>
                {r.tagline && <p class="rcard-tagline">{r.tagline}</p>}
              </div>

              {/* CTA row */}
              <div class="rcard-cta">
                <span class="rcard-cta-text">View Menu</span>
                <span class="rcard-cta-arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}

        {restaurants.length === 0 && (
          <div class="dir-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <p>No restaurants found.</p>
            <p class="dir-empty-sub">Add a folder to the <code>restaurants/</code> directory.</p>
          </div>
        )}
      </main>

      <footer class="dir-footer">
        <p>© {new Date().getFullYear()} Digital Menu Platform</p>
      </footer>
    </div>
  </body>
</html>

<style>
  /* Reset & base */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  
  .dir-body {
    min-height: 100vh;
    background: #0c0c0f;
    color: #f0f0f0;
    font-family: 'Inter', sans-serif;
    position: relative;
    overflow-x: hidden;
  }

  /* Ambient blobs */
  .blob {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.18;
    pointer-events: none;
    z-index: 0;
    animation: blobFloat 18s ease-in-out infinite;
  }
  .blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #8b5cf6, #3b82f6);
    top: -120px;
    right: -100px;
  }
  .blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #f59e0b, #ef4444);
    bottom: -80px;
    left: -80px;
    animation-delay: -9s;
  }
  @keyframes blobFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(20px, -20px) scale(1.05); }
    66%       { transform: translate(-15px, 15px) scale(0.97); }
  }

  /* Container */
  .dir-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header */
  .dir-header {
    text-align: center;
    padding: 5rem 1rem 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .dir-header-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 999px;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.25);
    color: #fbbf24;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .dir-headline {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .dir-headline-top {
    color: rgba(255,255,255,0.45);
    font-weight: 400;
    font-size: 0.55em;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .dir-headline-bottom {
    background: linear-gradient(135deg, #fff 30%, rgba(255,255,255,0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .dir-subheadline {
    font-size: 1rem;
    color: rgba(255,255,255,0.45);
    max-width: 36ch;
    line-height: 1.6;
  }

  /* Grid */
  .dir-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    padding-bottom: 5rem;
  }

  /* Restaurant card */
  .rcard {
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    overflow: hidden;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    text-decoration: none;
    color: inherit;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease, border-color 0.2s ease;
    animation: cardIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    will-change: transform;
  }
  .rcard:nth-child(1) { animation-delay: 0.05s; }
  .rcard:nth-child(2) { animation-delay: 0.12s; }
  .rcard:nth-child(3) { animation-delay: 0.19s; }
  .rcard:nth-child(4) { animation-delay: 0.26s; }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .rcard:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 24px 60px -12px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.14);
  }

  /* Cover */
  .rcard-cover {
    position: relative;
    height: 180px;
    overflow: hidden;
    background: #1a1a1f;
  }
  .rcard-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .rcard:hover .rcard-cover-img { transform: scale(1.06); }
  .rcard-cover-placeholder {
    width: 100%;
    height: 100%;
  }
  .rcard-cover-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.05) 100%);
  }
  .rcard-mood-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(8px);
    color: rgba(255,255,255,0.8);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid rgba(255,255,255,0.12);
  }

  /* Body */
  .rcard-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .rcard-logo-wrap {
    margin-top: -2.5rem;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    overflow: hidden;
    border: 2.5px solid rgba(255,255,255,0.12);
    background: #1e1e26;
    flex-shrink: 0;
  }
  .rcard-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rcard-text { flex: 1; }
  .rcard-name {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }
  .rcard-tagline {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA row */
  .rcard-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .rcard-cta-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255,255,255,0.55);
    transition: color 0.2s;
  }
  .rcard:hover .rcard-cta-text { color: #fbbf24; }
  .rcard-cta-arrow {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.4);
    transition: background 0.2s, color 0.2s, transform 0.25s;
  }
  .rcard:hover .rcard-cta-arrow {
    background: #fbbf24;
    color: #000;
    border-color: #fbbf24;
    transform: translateX(3px);
  }

  /* Empty state */
  .dir-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 5rem 2rem;
    color: rgba(255,255,255,0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .dir-empty code { font-size: 0.875em; background: rgba(255,255,255,0.08); padding: 2px 6px; border-radius: 4px; }
  .dir-empty-sub { font-size: 0.875rem; color: rgba(255,255,255,0.22); }

  /* Footer */
  .dir-footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.2);
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .blob, .rcard, .rcard-cover-img { animation: none; transition: none; }
  }
</style>
