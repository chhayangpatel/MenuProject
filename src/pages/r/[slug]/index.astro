---
import { loadAllRestaurants } from "../../../lib/loadRestaurants";
import RestaurantLayout from "../../../layouts/RestaurantLayout.astro";
import ItemDetailSheet from "../../../components/ItemDetailSheet";
import SearchFilterBar from "../../../components/SearchFilterBar";
import TemplateStyleManager from "../../../components/TemplateStyleManager.astro";
import { getTemplate, templates } from "../../../lib/templates/registry";
import { templateComponents } from "../../../lib/templates/components";
import { resolveMenuItemImage } from "../../../lib/assets";
import { basePath } from "../../../lib/base";
import type { Restaurant } from "../../../schemas/restaurant.schema";

export async function getStaticPaths() {
  const restaurants = await loadAllRestaurants();
  return restaurants.map((restaurant) => ({
    params: { slug: restaurant.slug },
    props: { restaurant },
  }));
}

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const { menu, settings, story } = restaurant;

// Template resolution: registry is the single source of truth
const template = getTemplate(restaurant.template, restaurant.moodPreset);
const components = templateComponents[template.id];
const {
  Hero: TemplateHero,
  Header: TemplateHeader,
  CategoryNav: TemplateCategoryNav,
  CategoryHero: TemplateCategoryHero,
  MenuCard: TemplateMenuCard,
  FeaturedCarousel: TemplateFeaturedCarousel,
  Footer: TemplateFooter,
} = components;

// Narrative effects are template-owned (registry.effects)
const enableScramble = template.effects.includes("scramble");

// Featured items + total for the menu overview strip
const featuredItems = menu
  .flatMap((cat) => cat.items)
  .filter((item) => item.featured);
const totalItems = menu.reduce((n, c) => n + c.items.length, 0);
const flatItems = menu
  .flatMap((c) => c.items)
  .map((item) => ({
    ...item,
    image: item.image
      ? resolveMenuItemImage(restaurant, item.image)
      : undefined,
    gallery: item.gallery?.map((img) => resolveMenuItemImage(restaurant, img)),
  }));
---

<RestaurantLayout restaurant={restaurant}>
  <TemplateStyleManager restaurant={restaurant} templateId={template.id} />

  <TemplateHero restaurant={restaurant} />
  <TemplateHeader restaurant={restaurant} />

  {
    story && (
      <section class="mr-story">
        <p class="mr-story-eyebrow">{story.heading || "Our Story"}</p>
        <p class="mr-story-body">{story.body}</p>
      </section>
    )
  }

  {
    featuredItems.length > 0 && (
      <TemplateFeaturedCarousel
        items={featuredItems}
        currencySymbol={settings?.currencySymbol}
        showPrices={settings?.showPrices}
        restaurant={restaurant}
      />
    )
  }

  {/* Sticky controls: search + filters, then category tabs (template-owned) */}
  <div class="mr-controls">
    <SearchFilterBar
      client:load
      enabled={settings?.enableSearch ?? true}
      enableDietaryFilters={settings?.enableDietaryFilters ?? true}
    />
  </div>
  <TemplateCategoryNav categories={menu} />

  {/* Menu body — centered, responsive, scannable */}
  <main class="mr-menu" id="menu-body">
    <p class="mr-menu-overview">
      {totalItems} dishes across {menu.length} categories
      <span class="mr-menu-overview-dot" aria-hidden="true">·</span>
      <a href="#top">back to top</a>
    </p>

    {
      menu.map((category, index) => (
        <section
          id={"category-" + category.id}
          class="mr-category"
          aria-labelledby={"cat-h-" + category.id}
        >
          <header class="mr-cat-head">
            <span class="mr-cat-eyebrow">
              {String(index + 1).padStart(2, "0")}
              <span class="mr-cat-eyebrow-rule" aria-hidden="true" />
              {category.items.length}{" "}
              {category.items.length === 1 ? "dish" : "dishes"}
            </span>
            <h2
              id={"cat-h-" + category.id}
              class="mr-cat-name"
              data-scramble={enableScramble ? "" : undefined}
            >
              {category.name}
            </h2>
            {category.description && (
              <p class="mr-cat-desc">{category.description}</p>
            )}
          </header>

          {category.heroImage ? (
            <TemplateCategoryHero
              category={category}
              slug={restaurant.slug}
              categoryIndex={index}
              restaurant={restaurant}
            />
          ) : null}

          <div class="mr-items-grid" data-stagger-container>
            {category.items.map((item) => (
              <div class="mr-reveal">
                <TemplateMenuCard
                  item={item}
                  currencySymbol={settings?.currencySymbol}
                  showPrices={settings?.showPrices}
                  restaurant={restaurant}
                />
              </div>
            ))}
          </div>

          {index < menu.length - 1 && (
            <div class="mr-divider" aria-hidden="true">
              <span />
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4" />
              </svg>
              <span />
            </div>
          )}
        </section>
      ))
    }
  </main>

  <TemplateFooter restaurant={restaurant} />

  {/* Floating back-to-top (appears after scrolling) */}
  <button class="mr-top-btn" id="mr-top-btn" aria-label="Back to top">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  {/* React island for item detail bottom sheet */}
  <ItemDetailSheet
    client:load
    currencySymbol={settings?.currencySymbol ?? "$"}
  />
</RestaurantLayout>

<!-- Inject menu data for the client-side item detail sheet -->
<script define:vars={{ flatItems }}>
  window.__RESTAURANT_ITEMS__ = flatItems;
</script>

<!-- Shared effect bootstrapping + back-to-top -->
<script>
  import { initPageEffects } from "../../../lib/client/effects";

  function setupTopButton() {
    const btn = document.getElementById("mr-top-btn");
    if (!btn || btn.dataset.topAttached) return;
    btn.dataset.topAttached = "true";
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          btn.classList.toggle("visible", window.scrollY > 600);
          ticking = false;
        });
      },
      { passive: true },
    );
  }

  document.addEventListener("astro:page-load", setupTopButton);
  if (document.readyState !== "loading") setupTopButton();
</script>

<!-- Template Switcher Bar -->
<nav class="tpl-switcher" aria-label="Template switcher">
  <span class="tpl-switcher-label">Templates</span>
  {
    Object.values(templates).map((t) => (
      <a
        href={
          t.id === restaurant.template
            ? basePath(`/r/${restaurant.slug}/`)
            : basePath(`/r/${restaurant.slug}/${t.id}/`)
        }
        class:list={["tpl-switcher-link", { active: t.id === template.id }]}
        aria-current={t.id === template.id ? "page" : undefined}
      >
        <span
          class="tpl-switcher-dot"
          style={"background: " + (t.colorDefaults.accentColor || "#D4AF37")}
        />
        {t.name}
      </a>
    ))
  }
</nav>

<style is:global>
  .tpl-switcher {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    background: rgba(11, 11, 13, 0.85);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(245, 242, 236, 0.08);
    border-radius: 999px;
    box-shadow:
      0 16px 48px -8px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(245, 242, 236, 0.05);
    max-width: calc(100vw - 2rem);
    animation: tplSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes tplSlideUp {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }
  .tpl-switcher-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.35);
    margin-right: 0.25rem;
    white-space: nowrap;
  }
  .tpl-switcher-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(245, 242, 236, 0.5);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
  }
  .tpl-switcher-link:hover {
    color: #f5f2ec;
    background: rgba(245, 242, 236, 0.06);
    border-color: rgba(245, 242, 236, 0.1);
  }
  .tpl-switcher-link.active {
    color: #0b0b0d;
    background: #d4af37;
    border-color: #d4af37;
    font-weight: 700;
  }
  .tpl-switcher-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .tpl-switcher {
      bottom: 0.5rem;
      padding: 0.375rem 0.5rem;
      gap: 0.25rem;
      border-radius: 1.5rem 1.5rem 0 0;
      width: 100%;
      max-width: 100%;
    }
    .tpl-switcher-label {
      display: none;
    }
    .tpl-switcher-link {
      padding: 0.375rem 0.5rem;
      font-size: 0.625rem;
    }
  }
</style>

<!-- Shared mr-* styles live in src/styles/global.css (imported by the layout) -->
