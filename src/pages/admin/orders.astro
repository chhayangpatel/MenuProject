---
import OrdersDashboard from "../../components/OrdersDashboard";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Queue — MenuProject</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style is:global raw>
    @import url("../../styles/admin-theme.css");
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: #0F0F0F; color: #F5F5F5; -webkit-font-smoothing: antialiased; }
  </style>
</head>
<body>
  <!-- Staff auth is handled inside the island: Supabase Auth session → staff
       row → restaurant slug. RLS scopes all data to that restaurant. -->
  <OrdersDashboard client:load />
</body>
</html>