---
/**
 * /digitalmenus — DigitalMenus brand landing page.
 * Matches the editorial premium aesthetic of the home page.
 * Where every restaurant menu's "Powered by DigitalMenus" badge routes to.
 */
import { basePath } from '../lib/base';

const year = new Date().getFullYear();

const features = [
  { title: 'Digital Menus', body: 'Guests scan and browse instantly — no app, no PDFs, no printing re-runs. One link, every phone.' },
  { title: 'Online Presence', body: 'We help small businesses get found and look world-class online — fast pages, social-ready links.' },
  { title: 'Designer Themes', body: 'Ten hand-crafted themes — from fine dining to street food — each with its own personality.' },
  { title: 'Live in 24 Hours', body: 'Send us your menu. We handle design, setup, codes, and launch — usually within a day.' },
];

const steps = [
  { n: '01', title: 'Share your menu', body: 'Send a photo, PDF, or plain text — whatever you have.' },
  { n: '02', title: 'We design & build', body: 'We match your brand with a theme, colors, and type that fit.' },
  { n: '03', title: 'Go live', body: 'Ready-to-print codes for tables, doors, and receipts.' },
];

const contacts = [
  { label: 'Email', value: 'hello@digitalmenus.app', href: 'mailto:hello@digitalmenus.app' },
  { label: 'WhatsApp', value: 'Chat with us', href: 'https://wa.me/15550100100' },
  { label: 'Call', value: '+1 (555) 010-0100', href: 'tel:+15550100100' },
];

// Premium logo: refined D + M monogram with fork tines
// Scales cleanly at all sizes
const logo = {
  nav: { w: 28, h: 28, d: 'M5 4v16M5 4h14M5 12h10M19 4v16' },
  footer: { w: 22, h: 22, d: 'M4 3v18M4 3h16M4 10.5h12M18 3v18' },
  badge: { w: 12, h: 12, d: 'M2 2v8M2 2h7M2 6h5M9 2v8' }
};
---

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DigitalMenus — Digital menus & online presence for restaurants</title>
    <meta name="description"
        content="DigitalMenus helps restaurants, cafés, and food trucks look world-class online with beautiful digital menus — live in 24 hours." />
    <link rel="icon" href={basePath('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
    </style>
</head>

<body class="dm-body">
    {/* Subtle grain overlay */}
    <div class="dm-grain" aria-hidden="true"></div>

    <div class="dm-container">
        <!-- ── Nav ─────────────────────────────────────────────── -->
        <header class="dm-nav">
            <a class="dm-wordmark" href={basePath('/digitalmenus')}>
                <svg class="dm-logo" width={logo.nav.w} height={logo.nav.h} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={logo.nav.d} />
                </svg>
                <span><em>Digital</em><strong>Menus</strong></span>
            </a>
            <a class="dm-nav-cta" href="#contact" data-scroll>Let's talk</a>
        </header>

        <!-- ── Hero ────────────────────────────────────────────── -->
        <section class="dm-hero">
            <p class="dm-eyebrow">
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
                Digital Menus Platform
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
            </p>
            <h1 class="dm-headline">
                <span class="dm-headline-serif">Your menu,</span>
                <span class="dm-headline-sans">beautifully digital.</span>
            </h1>
            <p class="dm-subheadline">
                DigitalMenus helps restaurants, cafés, and food trucks punch above
                their weight online — with stunning digital menus, fast mobile pages,
                and a brand presence that turns visitors into regulars.
            </p>
            <div class="dm-hero-actions">
                <a class="dm-btn dm-btn-primary" href="#contact" data-scroll>Let's talk</a>
                <a class="dm-btn dm-btn-ghost" href={basePath('/')}>See live demos →</a>
            </div>
            <div class="dm-hero-strip">
                <span>10 designer themes</span><span aria-hidden="true">·</span><span>Ready in 24 hours</span><span aria-hidden="true">·</span><span>No app needed</span>
            </div>
        </section>

        <!-- ── What we do ──────────────────────────────────────── -->
        <section class="dm-section">
            <p class="dm-eyebrow">
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
                What we do
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
            </p>
            <h2 class="dm-section-title">Everything a restaurant needs to shine online</h2>
            <div class="dm-feature-grid">
                {features.map((f, i) => (
                <article class="dm-card" style={`--delay: ${i * 100}ms`}>
                    <h3>{f.title}</h3>
                    <p>{f.body}</p>
                </article>
                ))}
            </div>
        </section>

        <!-- ── How it works ────────────────────────────────────── -->
        <section class="dm-section">
            <p class="dm-eyebrow">
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
                How it works
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
            </p>
            <h2 class="dm-section-title">From menu to live in three steps</h2>
            <div class="dm-steps">
                {steps.map((s, i) => (
                <div class="dm-step" style={`--delay: ${i * 100}ms`}>
                    <span class="dm-step-n">{s.n}</span>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                </div>
                ))}
            </div>
        </section>

        <!-- ── Reach out ───────────────────────────────────────── -->
        <section id="contact" class="dm-section dm-section-contact">
            <p class="dm-eyebrow">
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
                Reach out
                <span class="dm-eyebrow-line" aria-hidden="true"></span>
            </p>
            <h2 class="dm-section-title">Let's put your restaurant on the map</h2>
            <p class="dm-section-sub">
                Tell us about your place and we'll reply within one business day with a
                plan and a preview.
            </p>
            <div class="dm-contact-grid">
                {contacts.map((c, i) => (
                <a class="dm-contact-card" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined}
                    rel={c.href.startsWith('http') ? 'noopener' : undefined} style={`--delay: ${i * 100}ms`}>
                    <span class="dm-contact-label">{c.label}</span>
                    <span class="dm-contact-value">{c.value}</span>
                </a>
                ))}
            </div>
        </section>

        <!-- ── Footer ──────────────────────────────────────────── -->
        <footer class="dm-footer">
            <a class="dm-wordmark" href={basePath('/digitalmenus')}>
                <svg class="dm-logo" width={logo.footer.w} height={logo.footer.h} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={logo.footer.d} />
                </svg>
                <span><em>Digital</em><strong>Menus</strong></span>
            </a>
            <p class="dm-footer-tag">Helping restaurants increase their online presence.</p>
            <p class="dm-footer-copy">© {year} DigitalMenus. All rights reserved.</p>
        </footer>
    </div>

    <script>
        document.querySelectorAll('[data-scroll]').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const target = document.querySelector('#contact');
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>
</body>

</html>

<style is:global>
/* ── Reset & Base ────────────────────────────────────────────── */
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --dm-bg: #0b0b0d;
    --dm-ink: #f5f2ec;
    --dm-ink-60: rgba(245, 242, 236, 0.4);
    --dm-ink-30: rgba(245, 242, 236, 0.3);
    --dm-ink-15: rgba(245, 242, 236, 0.15);
    --dm-gold: #d4af37;
    --dm-gold-soft: rgba(212, 175, 55, 0.15);
    --dm-card: rgba(245, 242, 236, 0.02);
    --dm-border: rgba(245, 242, 236, 0.06);
    --dm-border-hover: rgba(212, 175, 55, 0.3);
    --dm-scrim: linear-gradient(to top, rgba(11, 11, 13, 0.9), rgba(11, 11, 13, 0.1), transparent);
}

.dm-body {
    min-height: 100vh;
    background: var(--dm-bg);
    color: var(--dm-ink);
    font-family: "Plus Jakarta Sans", sans-serif;
    line-height: 1.6;
    position: relative;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* Subtle grain texture — matches home page */
.dm-grain {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
}

.dm-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
}

/* ── Eyebrow / Section Titles (matches home page) ───────────── */
.dm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dm-ink-30);
    margin-bottom: 1.25rem;
}
.dm-eyebrow-line {
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--dm-gold));
}
.dm-eyebrow-line:last-child {
    background: linear-gradient(90deg, var(--dm-gold), transparent);
}

.dm-section-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.01em;
    color: var(--dm-ink);
    margin-bottom: 2.5rem;
    max-width: 42rem;
    line-height: 1.2;
}
.dm-section-sub {
    color: var(--dm-ink-60);
    max-width: 36rem;
    margin: -1.5rem 0 2.5rem;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.7;
}

.dm-section {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
}

/* ── Nav ─────────────────────────────────────────────────────── */
.dm-nav {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
}

.dm-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--dm-ink);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: -0.01em;
}
.dm-wordmark em {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-weight: 500;
    color: var(--dm-ink-60);
    font-size: 0.95em;
}
.dm-wordmark strong {
    font-weight: 800;
    letter-spacing: -0.02em;
}
.dm-logo {
    display: block;
    color: var(--dm-gold);
    transition: color 0.3s ease;
}
.dm-wordmark:hover .dm-logo {
    color: var(--dm-ink);
}

.dm-nav-cta {
    padding: 0.625rem 1.5rem;
    border-radius: 999px;
    background: var(--dm-gold);
    color: var(--dm-bg);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 4px 16px -4px var(--dm-gold);
}
.dm-nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px -8px var(--dm-gold);
    background: #e8c55a;
}

/* ── Hero ────────────────────────────────────────────────────── */
.dm-hero {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
    padding: 6rem 1.5rem 5rem;
    text-align: center;
}

.dm-headline {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.05;
    margin-bottom: 1.5rem;
}
.dm-headline-serif {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 500;
    font-style: italic;
    color: var(--dm-ink-60);
    letter-spacing: -0.01em;
}
.dm-headline-sans {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #fff 30%, rgba(255,255,255,0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-top: -0.15em;
}

.dm-subheadline {
    max-width: 44rem;
    margin: 0 auto 3rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--dm-ink-60);
    line-height: 1.7;
    font-weight: 300;
}

.dm-hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
}

.dm-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.9375rem 2rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.dm-btn-primary {
    background: var(--dm-gold);
    color: var(--dm-bg);
    box-shadow: 0 4px 20px -4px var(--dm-gold);
}
.dm-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -10px var(--dm-gold);
    background: #e8c55a;
}
.dm-btn-ghost {
    border: 1px solid var(--dm-border);
    color: var(--dm-ink);
    background: var(--dm-card);
}
.dm-btn-ghost:hover {
    border-color: var(--dm-gold);
    color: var(--dm-gold);
    transform: translateY(-2px);
}

.dm-hero-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dm-ink-30);
}
.dm-hero-strip span[aria-hidden] {
    color: var(--dm-gold);
    opacity: 0.5;
}

/* ── Feature Grid ────────────────────────────────────────────── */
.dm-feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
}

.dm-card {
    padding: 2rem;
    border-radius: 1.25rem;
    border: 1px solid var(--dm-border);
    background: var(--dm-card);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(20px);
    animation: cardIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0);
}
@keyframes cardIn {
    to { opacity: 1; transform: translateY(0); }
}
.dm-card:hover {
    transform: translateY(-4px);
    border-color: var(--dm-border-hover);
    background: rgba(212, 175, 55, 0.04);
    box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.4);
}

.dm-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.25rem;
    font-weight: 600;
    font-style: italic;
    color: var(--dm-gold);
    margin-bottom: 0.75rem;
}
.dm-card p {
    font-size: 0.9375rem;
    color: var(--dm-ink-60);
    margin: 0;
    line-height: 1.7;
}

/* ── Steps ───────────────────────────────────────────────────── */
.dm-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
}

.dm-step {
    padding: 2rem;
    border-radius: 1.25rem;
    border: 1px solid var(--dm-border);
    background: var(--dm-card);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(20px);
    animation: cardIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0);
}
.dm-step:hover {
    border-color: var(--dm-border-hover);
    background: rgba(212, 175, 55, 0.04);
}

.dm-step-n {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--dm-gold);
    opacity: 0.15;
    line-height: 1;
    margin-bottom: 1rem;
    display: block;
}
.dm-step h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.125rem;
    font-weight: 600;
    font-style: italic;
    color: var(--dm-ink);
    margin-bottom: 0.5rem;
}
.dm-step p {
    font-size: 0.9375rem;
    color: var(--dm-ink-60);
    margin: 0;
    line-height: 1.7;
}

/* ── Contact ─────────────────────────────────────────────────── */
.dm-section-contact {
    text-align: center;
}
.dm-section-contact .dm-section-title {
    margin-left: auto;
    margin-right: auto;
}
.dm-section-contact .dm-section-sub {
    margin-left: auto;
    margin-right: auto;
}

.dm-contact-grid {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.dm-contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.5rem 2.5rem;
    border-radius: 1.25rem;
    border: 1px solid var(--dm-border);
    background: var(--dm-card);
    text-decoration: none;
    color: var(--dm-ink);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(20px);
    animation: cardIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0);
}
.dm-contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--dm-gold);
    background: var(--dm-gold-soft);
    box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.4);
}

.dm-contact-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dm-gold);
}
.dm-contact-value {
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--dm-ink);
}

/* ── Footer ──────────────────────────────────────────────────── */
.dm-footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    border-top: 1px solid var(--dm-border);
}

.dm-footer .dm-wordmark {
    justify-content: center;
    margin-bottom: 1.25rem;
}
.dm-footer .dm-logo {
    color: var(--dm-ink-30);
}

.dm-footer-tag {
    font-size: 0.875rem;
    color: var(--dm-ink-60);
    font-weight: 300;
    margin-bottom: 0.75rem;
}
.dm-footer-copy {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dm-ink-15);
    margin: 0;
}

/* ── Mobile ──────────────────────────────────────────────────── */
@media (max-width: 640px) {
    .dm-container { padding: 0 1rem; }

    /* Nav */
    .dm-nav { gap: 0.75rem; }
    .dm-wordmark { gap: 0.375rem; font-size: 0.875rem; }
    .dm-nav-cta {
        padding: 0.55rem 1.1rem;
        font-size: 0.75rem;
    }

    /* Hero */
    .dm-hero { padding: 4rem 1rem 3.5rem; }
    .dm-headline-serif { font-size: 2rem; }
    .dm-headline-sans { font-size: 2.25rem; }
    .dm-subheadline { font-size: 0.9375rem; margin-bottom: 2rem; }
    .dm-hero-actions { flex-direction: column; align-items: center; gap: 0.75rem; margin-bottom: 2.5rem; }
    .dm-btn { width: 100%; max-width: 280px; justify-content: center; padding: 0.875rem 1.5rem; }
    .dm-hero-strip { font-size: 0.625rem; gap: 1rem; }

    /* Sections */
    .dm-section { padding: 3rem 1rem; }
    .dm-section-title { font-size: 1.75rem; margin-bottom: 1.5rem; }

    /* Cards */
    .dm-card, .dm-step { padding: 1.5rem; }
    .dm-step-n { font-size: 1.75rem; margin-bottom: 0.75rem; }

    /* Contact */
    .dm-contact-card { padding: 1.25rem 1.5rem; width: 100%; max-width: 320px; }

    /* Footer */
    .dm-footer { padding: 3rem 1rem 2rem; }
    .dm-footer .dm-wordmark { gap: 0.375rem; font-size: 0.875rem; }
}

/* ── Touch-friendly (below 480px) ──────────────────────────── */
@media (max-width: 480px) {
    .dm-hero { padding: 3.5rem 0.75rem 3rem; }
    .dm-headline-serif { font-size: 1.65rem; }
    .dm-headline-sans { font-size: 1.85rem; }
    .dm-btn { max-width: 240px; padding: 0.8125rem 1.25rem; }
    .dm-feature-grid,
    .dm-steps { gap: 1rem; }
    .dm-card, .dm-step { padding: 1.25rem; }
    .dm-card h3, .dm-step h3 { font-size: 1.05rem; }
    .dm-contact-grid { gap: 0.75rem; }
}

/* ── Reduced Motion ──────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .dm-card, .dm-step, .dm-contact-card {
