---
interface Props {
  icon?: string;
  text: string;
}

const { icon, text } = Astro.props;
---

<span class="eyebrow">
  {icon && <span class="eyebrow-icon" set:html={icon} />}
  {text}
</span>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
    color: var(--color-accent);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: var(--font-body);
  }
  .eyebrow-icon {
    display: inline-flex;
    font-size: 0.75rem;
  }
</style>
