---
/**
 * HeroStory — renders the restaurant's story as a short 2-3 line summary
 * directly inside the hero, under the title/tagline. Inherits the hero's
 * text color (white over cover images, primary on light heroes).
 */
import type { Restaurant } from '../schemas/restaurant.schema';

interface Props {
  restaurant: Restaurant;
  /** Set true when the hero sits over a dark cover image (light text) */
  light?: boolean;
}

const { restaurant, light = false } = Astro.props;
const story = restaurant.story?.body;
---

{story && <p class={"hero-story" + (light ? " hero-story-light" : "")}>{story}</p>}

<style>
  .hero-story {
    max-width: 44ch;
    margin: 1.1rem auto 0;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    line-height: 1.7;
    opacity: 0.85;
    text-wrap: balance;
  }
  .hero-story-light {
    color: #fff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
  }
</style>