---
import type { Restaurant } from '../schemas/restaurant.schema';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const heroStyle = restaurant.hero?.style || 'fullbleed';
const hasCover = !!restaurant.coverImage;
const coverUrl = hasCover ? ('/r/' + restaurant.slug + '/assets/' + restaurant.coverImage) : '';
const logoUrl = '/r/' + restaurant.slug + '/assets/' + restaurant.logo;
---

<div class="hero-wrapper relative w-full overflow-hidden" style={hasCover && heroStyle !== 'minimal' ? 'min-height: 70vh;' : 'padding: 5rem 1.5rem 3rem;'}>
  
  {hasCover && heroStyle !== 'minimal' && (
    <>
      {/* Cover image */}
      <img
        src={coverUrl}
        alt=""
        class="hero-bg absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      {/* Multi-layer gradient scrim */}
      <div class="absolute inset-0 hero-scrim"></div>
      {/* Subtle noise texture overlay */}
      <div class="absolute inset-0 opacity-20" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.4'/%3E%3C/svg%3E&quot;); background-size: 200px 200px; mix-blend-mode: overlay;"></div>
    </>
  )}

  {/* Main content */}
  <div class="relative z-10 flex flex-col items-center text-center px-6 hero-content">
    
    {/* Logo with glow ring */}
    <div class="logo-ring mb-6">
      <img
        src={logoUrl}
        alt={restaurant.name}
        class="logo-img"
      />
    </div>

    {/* Name */}
    <h1 class={"hero-title " + (hasCover && heroStyle !== 'minimal' ? 'text-white' : 'text-primary')}>
      {restaurant.name}
    </h1>

    {/* Decorative line */}
    <div class={"hero-divider " + (hasCover && heroStyle !== 'minimal' ? 'divider-light' : 'divider-accent')}></div>

    {/* Tagline */}
    {restaurant.tagline && (
      <p class={"hero-tagline " + (hasCover && heroStyle !== 'minimal' ? 'tagline-light' : 'tagline-dark')}>
        {restaurant.tagline}
      </p>
    )}

    {/* Scroll cue */}
    {hasCover && heroStyle === 'fullbleed' && (
      <div class="scroll-cue mt-10">
        <span class="scroll-dot"></span>
      </div>
    )}
  </div>
</div>

<style>
  .hero-wrapper {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-bg {
    animation: heroZoom 12s ease-in-out infinite alternate;
    transform-origin: center;
  }

  @keyframes heroZoom {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  .hero-scrim {
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.82) 0%,
      rgba(0,0,0,0.3) 50%,
      rgba(0,0,0,0.05) 100%
    );
  }

  .hero-content {
    padding-bottom: 3.5rem;
    padding-top: 5rem;
    animation: contentUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes contentUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Logo */
  .logo-ring {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--color-accent), transparent 60%);
    box-shadow: 0 0 0 1px rgba(255,255,255,0.15), 0 8px 32px rgba(0,0,0,0.4);
    animation: logoPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
  }

  @keyframes logoPop {
    from { opacity: 0; transform: scale(0.7); }
    to   { opacity: 1; transform: scale(1); }
  }

  .logo-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-secondary);
  }

  /* Title */
  .hero-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .text-white { color: #fff; text-shadow: 0 2px 20px rgba(0,0,0,0.5); }
  .text-primary { color: var(--color-primary); }

  /* Divider */
  .hero-divider {
    width: 48px;
    height: 2px;
    border-radius: 1px;
    margin: 0.75rem auto 1rem;
    animation: dividerGrow 0.6s ease 0.5s both;
  }
  @keyframes dividerGrow {
    from { width: 0; opacity: 0; }
    to   { width: 48px; opacity: 1; }
  }
  .divider-light { background: rgba(255,255,255,0.5); }
  .divider-accent { background: var(--color-accent); }

  /* Tagline */
  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 2.5vw, 1.15rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    max-width: 36ch;
    line-height: 1.6;
    animation: contentUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }
  .tagline-light { color: rgba(255,255,255,0.82); }
  .tagline-dark  { color: var(--color-primary); opacity: 0.7; }

  /* Scroll cue */
  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    opacity: 0.6;
  }
  .scroll-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fff;
    animation: scrollBounce 1.8s ease-in-out infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%       { transform: translateY(8px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg, .hero-content, .logo-ring, .hero-tagline { animation: none; opacity: 1; transform: none; }
    .hero-divider { animation: none; }
  }
</style>
