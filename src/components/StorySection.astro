---
import type { Restaurant } from '../schemas/restaurant.schema';

interface Props {
  story: NonNullable<Restaurant['story']>;
}

const { story } = Astro.props;
---

<section class="story-section" aria-labelledby="story-heading">
  <div class="story-inner">
    <div class="story-icon" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    </div>
    <h2 class="story-heading" id="story-heading">{story.heading || 'Our Story'}</h2>
    <div class="story-divider" aria-hidden="true"></div>
    <p class="story-body">{story.body}</p>
  </div>
</section>

<style>
  .story-section {
    padding: 4rem 1.5rem;
    text-align: center;
    background: color-mix(in srgb, var(--color-primary) 3%, var(--color-secondary));
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 6%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 6%, transparent);
  }
  .story-inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .story-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .story-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .story-divider {
    width: 32px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
    margin: 0.75rem auto 1.5rem;
    opacity: 0.7;
  }
  .story-body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-primary) 70%, transparent);
    font-style: italic;
  }
</style>
