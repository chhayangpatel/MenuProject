---
import type { Restaurant } from '../schemas/restaurant.schema';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const { contact } = restaurant;
const logoUrl = '/r/' + restaurant.slug + '/assets/' + restaurant.logo;
---

<header class="sticky top-0 z-40 site-header" id="main-header">
  <div class="header-inner max-w-3xl mx-auto px-4 h-14 flex items-center justify-between">
    
    <div class="flex items-center gap-3 overflow-hidden">
      <img
        src={logoUrl}
        alt={restaurant.name}
        class="header-logo"
      />
      <span class="header-name">{restaurant.name}</span>
    </div>

    <nav class="flex items-center gap-1" aria-label="Contact">
      {contact?.phone && (
        <a href={"tel:" + contact.phone} aria-label="Call us" class="icon-btn" title="Call us">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.4 19.79 19.79 0 0 1 1.61 4.78 2 2 0 0 1 3.58 2.6h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.09a16 16 0 0 0 6 6l1.06-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17.5z"/>
          </svg>
        </a>
      )}
      {contact?.whatsapp && (
        <a href={"https://wa.me/" + contact.whatsapp.replace(/[^0-9]/g, '')} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="icon-btn" title="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.885 3.488"/>
          </svg>
        </a>
      )}
      {contact?.googleMapsUrl && (
        <a href={contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Get Directions" class="icon-btn" title="Directions">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </a>
      )}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--color-secondary) 88%, transparent);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    transition: box-shadow 0.3s ease;
  }
  .site-header.scrolled {
    box-shadow: 0 4px 24px rgba(0,0,0,0.1);
  }
  .header-logo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .header-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius, 8px);
    color: color-mix(in srgb, var(--color-primary) 70%, transparent);
    transition: color 0.2s, background 0.2s, transform 0.15s;
  }
  .icon-btn:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    transform: scale(1.1);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('main-header');
    if (!header) return;
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
