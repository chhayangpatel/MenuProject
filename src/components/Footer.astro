---
import type { Restaurant } from '../schemas/restaurant.schema';

interface Props {
  restaurant: Restaurant;
}

const { restaurant } = Astro.props;
const { hours, contact } = restaurant;
const hourEntries = hours?.regular ? Object.entries(hours.regular) : (hours && !hours.regular ? Object.entries(hours as Record<string, string>) : []);
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-body max-w-3xl mx-auto">

    {/* Restaurant identity */}
    <div class="footer-brand">
      <p class="footer-brand-name">{restaurant.name}</p>
      {restaurant.tagline && <p class="footer-tagline">{restaurant.tagline}</p>}
    </div>

    <div class="footer-grid">
      {/* Hours */}
      {hourEntries.length > 0 && (
        <div class="footer-col">
          <h3 class="footer-col-heading">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            Hours
          </h3>
          <ul class="hours-list">
            {hourEntries.map(([day, time]) => (
              <li class="hours-row">
                <span class="hours-day">{day}</span>
                <span class="hours-time">{time}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* Location & Contact */}
      <div class="footer-col">
        <h3 class="footer-col-heading">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Location
        </h3>
        {contact?.address && (
          <p class="footer-address">{contact.address}</p>
        )}
        {contact?.googleMapsUrl && (
          <a href={contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="footer-link footer-map-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
            Get Directions
          </a>
        )}
        {contact?.phone && (
          <a href={"tel:" + contact.phone} class="footer-link">
            {contact.phone}
          </a>
        )}
        {contact?.email && (
          <a href={"mailto:" + contact.email} class="footer-link">
            {contact.email}
          </a>
        )}

        {/* Social links */}
        {contact?.socials && Object.keys(contact.socials).length > 0 && (
          <div class="social-row">
            {Object.entries(contact.socials).map(([platform, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="social-link" title={platform}>
                {platform}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="footer-bottom max-w-3xl mx-auto">
    <span>© {new Date().getFullYear()} {restaurant.name}</span>
    <span class="footer-powered">Digital Menu</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    padding: 3rem 1.5rem 1.5rem;
    background: color-mix(in srgb, var(--color-primary) 5%, var(--color-secondary));
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  .footer-body { display: flex; flex-direction: column; gap: 2rem; }

  .footer-brand { text-align: center; }
  .footer-brand-name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
  }
  .footer-tagline {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    margin-top: 0.25rem;
    font-style: italic;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 480px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }

  .footer-col {}
  .footer-col-heading {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.875rem;
  }

  .hours-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .hours-row {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-primary) 75%, transparent);
  }
  .hours-day { text-transform: capitalize; font-weight: 500; color: var(--color-primary); }
  .hours-time {}

  .footer-address {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-primary) 70%, transparent);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    white-space: pre-line;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-primary) 65%, transparent);
    text-decoration: none;
    margin-top: 0.3rem;
    transition: color 0.2s;
    display: block;
  }
  .footer-link:hover { color: var(--color-accent); }
  .footer-map-link {
    display: inline-flex !important;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-accent) !important;
    font-weight: 600;
    font-size: 0.8125rem;
  }

  .social-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .social-link {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .social-link:hover { color: var(--color-accent); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--color-primary) 38%, transparent);
  }
  .footer-powered { font-style: italic; }
</style>
