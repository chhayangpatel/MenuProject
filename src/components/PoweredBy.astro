---
/**
 * PoweredBy — platform branding shown at the very bottom of every footer.
 * Uses template's existing CSS variables to match the active theme.
 */
import { basePath } from '../lib/base';
---
<div class="dm-powered-wrap">
  <a href={basePath('/digitalmenus')} class="dm-powered" target="_blank" rel="noopener" aria-label="Powered by DigitalMenus — click to learn more">
    <span class="dm-powered-mark" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <defs>
          <linearGradient id="dm-grad" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
            <stop stop-color="var(--color-accent, var(--ec-accent, #C9A227))"/>
            <stop offset="1" stop-color="var(--color-primary, var(--ec-primary, #8B0000))"/>
          </linearGradient>
        </defs>
        <rect x="2"  y="2"  width="7" height="7" rx="1.5" fill="url(#dm-grad)"/>
        <rect x="15" y="2"  width="7" height="7" rx="1.5" fill="url(#dm-grad)"/>
        <rect x="2"  y="15" width="7" height="7" rx="1.5" fill="url(#dm-grad)"/>
        <rect x="10" y="10" width="4" height="4" rx="1" fill="url(#dm-grad)"/>
        <rect x="15" y="15" width="2" height="2" rx="0.5" fill="url(#dm-grad)" opacity="0.7"/>
        <rect x="19" y="15" width="2" height="2" rx="0.5" fill="url(#dm-grad)" opacity="0.7"/>
        <rect x="15" y="19" width="2" height="2" rx="0.5" fill="url(#dm-grad)" opacity="0.7"/>
        <rect x="19" y="19" width="2" height="2" rx="0.5" fill="url(#dm-grad)" opacity="0.7"/>
      </svg>
    </span>
    <span class="dm-powered-text">
      Powered by <strong class="dm-brand">DigitalMenus</strong>
    </span>
  </a>
</div>

<style>
  .dm-powered-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-primary, var(--ec-primary, #111)) 8%, transparent);
    margin-top: 0.5rem;
  }

  .dm-powered {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.1rem 0.5rem 0.75rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--font-body, var(--ec-font-body, system-ui, sans-serif));
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    line-height: 1;
    color: color-mix(in srgb, var(--color-primary, var(--ec-primary, #111)) 60%, transparent);
    background: color-mix(in srgb, var(--color-primary, var(--ec-primary, #111)) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary, var(--ec-primary, #111)) 12%, transparent);
    transition: all 0.25s ease;
  }

  .dm-powered:hover,
  .dm-powered:focus-visible {
    background: color-mix(in srgb, var(--color-accent, var(--ec-accent, #C9A227)) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent, var(--ec-accent, #C9A227)) 30%, transparent);
    color: var(--color-accent, var(--ec-accent, #C9A227));
    transform: translateY(-1px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent, var(--ec-accent, #C9A227)) 15%, transparent);
    outline: none;
  }

  .dm-powered-mark {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .dm-powered-text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
  }

  .dm-brand {
    font-weight: 700;
    letter-spacing: 0.01em;
  }
</style>