---
import type { MenuItem } from '../schemas/restaurant.schema';
import MenuItemCard from './MenuItemCard.astro';

interface Props {
  items: MenuItem[];
  currencySymbol?: string;
  showPrices?: boolean;
}

const { items, currencySymbol, showPrices } = Astro.props;
/* Cap at the top 4 items and lay them out in a responsive grid */
const featured = items.slice(0, 4);
---

<section class="featured-section" aria-labelledby="featured-heading">
  <div class="featured-header">
    <div class="featured-label" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
      Featured
    </div>
    <h2 class="featured-heading" id="featured-heading">Must-Try Dishes</h2>
  </div>

  <div class="featured-grid" role="list" aria-label="Featured items">
    {featured.map(item => (
      <div class="featured-grid-item" role="listitem">
        <MenuItemCard item={{ ...item, restaurantSlug: (item as any).restaurantSlug || '' }} currencySymbol={currencySymbol} showPrices={showPrices} />
      </div>
    ))}
  </div>
</section>

<style>
  .featured-section {
    padding: 2rem 0;
  }
  .featured-header {
    padding: 0 1.25rem;
    margin-bottom: 1.25rem;
  }
  .featured-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .featured-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 4vw, 1.75rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
  }
  /* Responsive grid: 1 col on phone, 2 on tablet, up to 4 on desktop */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    padding: 0 1.25rem;
  }
  @media (min-width: 540px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .featured-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>