---
import type { MenuItem } from '../schemas/restaurant.schema';

interface Props {
  item: MenuItem;
  currencySymbol?: string;
  showPrices?: boolean;
}

const { item, currencySymbol = '$', showPrices = true } = Astro.props;
const hasImage = !!item.image;
const isVegetarian = item.tags.includes('vegetarian');
const isVegan = item.tags.includes('vegan');
const isGlutenFree = item.tags.includes('gluten-free');
const hasVariants = item.variants && item.variants.length > 0;
---

<article
  class={"menu-card-outer" + (!item.available ? " menu-card--unavailable" : "") + (item.featured ? " menu-card--featured" : "")}
  data-item-id={item.id}
  role="button"
  tabindex="0"
  aria-label={"View details for " + item.name}
>
  <div class="menu-card">
    {/* Featured badge */}
    {item.featured && (
      <div class="featured-badge" aria-label="Chef's Pick">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        Chef's Pick
      </div>
    )}

    {/* Popularity badge */}
    {item.popularity && (
      <div class={`popularity-badge popularity-badge--${item.popularity}`}>
        {item.popularity === 'most-ordered' && '🔥 Most Ordered'}
        {item.popularity === 'staff-favorite' && '⭐ Staff Pick'}
        {item.popularity === 'new' && '✨ New'}
        {item.popularity === 'trending' && '📈 Trending'}
      </div>
    )}

    {/* Sold Out overlay */}
    {!item.available && (
      <div class="sold-out-overlay" aria-live="polite">
        <span class="sold-out-badge">Sold Out</span>
      </div>
    )}

    <div class="card-body">
      {/* Text */}
      <div class="card-text">
        <div class="card-header-row">
          <h3 class="item-name">{item.name}</h3>
          {showPrices && (
            <span class="item-price">
              {hasVariants && <span class="item-price-from">From </span>}
              {currencySymbol}{item.price.toFixed(2)}
            </span>
          )}
        </div>

        {item.description && (
          <p class="item-desc">{item.description}</p>
        )}

        {/* Meta info */}
        <div class="card-meta">
          {item.prepTime && (
            <span class="meta-item">⏱ {item.prepTime}min</span>
          )}
          {item.portionSize && (
            <span class="meta-item">📏 {item.portionSize}</span>
          )}
        </div>

        {/* Tags row */}
        <div class="tags-row">
          {isVegetarian && !isVegan && (
            <span class="tag tag--green" title="Vegetarian">🌿 Veg</span>
          )}
          {isVegan && (
            <span class="tag tag--green" title="Vegan">🌱 Vegan</span>
          )}
          {isGlutenFree && (
            <span class="tag tag--amber" title="Gluten-Free">GF</span>
          )}
          {item.spicyLevel > 0 && (
            <span class="tag tag--red" title={"Spicy Level " + item.spicyLevel}>
              {"🌶️".repeat(item.spicyLevel)}
            </span>
          )}
          {item.nutrition?.calories && (
            <span class="tag tag--muted">{item.nutrition.calories} cal</span>
          )}
        </div>
      </div>

      {/* Image */}
      {hasImage && (
        <div class="card-img-wrap">
          <img
            src={item.image}
            alt={item.name}
            class="card-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
    </div>

    {/* Hover arrow cue */}
    <div class="card-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </div>
  </div>
</article>

<style>
  /* Double-Bezel Architecture */
  .menu-card-outer {
    position: relative;
    background: color-mix(in srgb, var(--color-primary) 3%, var(--color-secondary));
    border: 1px solid color-mix(in srgb, var(--color-primary) 6%, transparent);
    border-radius: calc(var(--radius, 0.5rem) + 0.25rem);
    padding: 5px;
    cursor: pointer;
    transition: transform 0.7s cubic-bezier(0.32, 0.72, 0, 1),
                box-shadow 0.7s cubic-bezier(0.32, 0.72, 0, 1),
                border-color 0.3s ease;
    will-change: transform;
  }
  .menu-card-outer:hover, .menu-card-outer:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 24px 48px -12px color-mix(in srgb, var(--color-primary) 15%, transparent),
                0 0 0 1px color-mix(in srgb, var(--color-accent) 20%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 25%, transparent);
    outline: none;
  }

  .menu-card {
    position: relative;
    background: var(--color-secondary);
    border-radius: var(--radius, 0.5rem);
    overflow: hidden;
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.15);
  }

  .menu-card--featured {
    border-color: color-mix(in srgb, var(--color-accent) 25%, transparent);
    background: color-mix(in srgb, var(--color-accent) 3%, var(--color-secondary));
  }
  .menu-card--unavailable {
    opacity: 0.55;
    filter: grayscale(0.4);
    pointer-events: none;
  }

  /* Featured badge */
  .featured-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  /* Popularity badge */
  .popularity-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    padding: 3px 8px;
    background: color-mix(in srgb, var(--color-primary) 85%, transparent);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 600;
    border-radius: 999px;
  }

  /* Sold out */
  .sold-out-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-secondary) 60%, transparent);
  }
  .sold-out-badge {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-secondary);
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    padding: 4px 12px;
    border-radius: 999px;
  }

  /* Body layout */
  .card-body {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
  }

  /* Text */
  .card-text {
    flex: 1;
    min-width: 0;
  }
  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  .item-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--color-primary);
    transition: color 0.2s;
  }
  .menu-card-outer:hover .item-name { color: var(--color-accent); }
  .item-price {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .item-price-from {
    font-size: 0.75em;
    font-weight: 400;
    opacity: 0.6;
  }
  .item-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-primary) 62%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  /* Meta info */
  .card-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .meta-item {
    font-size: 0.6875rem;
    color: color-mix(in srgb, var(--color-primary) 45%, transparent);
    font-weight: 500;
  }

  /* Tags */
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.5rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .tag--green  { background: #dcfce7; color: #15803d; }
  .tag--amber  { background: #fef3c7; color: #b45309; }
  .tag--red    { background: #fee2e2; color: #b91c1c; }
  .tag--muted  { background: color-mix(in srgb, var(--color-primary) 8%, transparent); color: color-mix(in srgb, var(--color-primary) 60%, transparent); }

  /* Image */
  .card-img-wrap {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: calc(var(--radius, 0.5rem) * 0.8);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-primary) 6%, transparent);
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .menu-card-outer:hover .card-img { transform: scale(1.07); }

  /* Arrow cue */
  .card-arrow {
    position: absolute;
    right: 10px;
    bottom: 10px;
    color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .menu-card-outer:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
