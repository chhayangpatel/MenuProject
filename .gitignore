# ---- Dependencies ---------------------------------------------------------
node_modules/
.pnp
.pnp.*

# ---- Astro build output ----------------------------------------------------
dist/
.astro/

# ---- Testing / coverage ----------------------------------------------------
coverage/
.bundle/
.nyc_output/

# ---- Caches -----------------------------------------------------------------
.cache/
.turbo/
.parcel-cache/
.vite/

# ---- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Environment variables ---------------------------------------------------
# Keep tracked: .env.example — add your own real .env files locally.
.env
.env.*
!.env.example
.env.local
.env.*.local

# ---- Editors (VS Code) ---------------------------------------------------------
# Ignore all VS Code files (personal/workspace-local state)
.vscode/

# ---- AI Assistant / Agent files --------------------------------------------------
# Claude, Cursor, Windsurf, Augment, Codex, Factory, Goose, OpenCode, Roo, Cline
.claude/
.cursor/
.cursorrules
.windsurfrules
.augmentrules/
.codex/
.factory/
.goose/
.opencode/
.roo/
.cline/
.clinerules

# ---- Other editors --------------------------------------------------------------
.idea/
*.iml
*.swp
*.swo

# ---- OS -------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---- Generated assets (copied by scripts/copy-assets.mjs) -------------------
# Restaurant assets are copied from restaurants/<slug>/assets/ to public/r/<slug>/assets/
# during build. Do not commit the copies.
public/r/

# ---- Temporary scripts -----------------------------------------------------------
# One-off scripts used for generation/cleanup. Remove when no longer needed.
script.mjs
scripts/cleanup-and-rebuild.mjs
scripts/register-new-templates.mjs
scripts/update-logos.mjs
scripts/generate-templates.mjs
scripts/create-distinct-templates.mjs
scripts/fix-registry.mjs

# ---- Misc ------------------------------------------------------------------------
*.pem
*.crt
*.key
