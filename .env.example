# Cloudflare Worker URL — used by the admin dashboard to save restaurant changes.
# Set this to your deployed Worker URL after running `cd worker && npx wrangler deploy`.
# Example: VITE_WORKER_URL=https://menu-admin.YOUR-SUBDOMAIN.workers.dev
# For local dev, leave it unset (defaults to http://localhost:8787 when running `wrangler dev`).
VITE_WORKER_URL=
